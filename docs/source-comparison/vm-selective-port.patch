+import { z } from "zod";
+
+export const ollamaAvailabilitySchema = z.enum([
+  "disabled",
+  "ready",
+  "unavailable",
+  "degraded",
+  "model_unavailable",
+  "unsupported_capability",
+  "timeout",
+  "incompatible",
+  "failed",
+]);
+
+export type OllamaAvailability = z.infer<typeof ollamaAvailabilitySchema>;
+
+export const ollamaHealthSchema = z
+  .object({
+    state: ollamaAvailabilitySchema,
+    detail: z.string().max(500).optional(),
+  })
+  .strict();
+
+export type OllamaHealth = z.infer<typeof ollamaHealthSchema>;
+
+export const ollamaModelSchema = z
+  .object({
+    id: z.string().min(1).max(255),
+    label: z.string().min(1).max(255).optional(),
+  })
+  .strict();
+
+export type OllamaModel = z.infer<typeof ollamaModelSchema>;
+
+export const ollamaModelsSchema = z
+  .object({
+    state: ollamaAvailabilitySchema,
+    models: z.array(ollamaModelSchema).max(100),
+  })
+  .strict();
+
+export type OllamaModels = z.infer<typeof ollamaModelsSchema>;
+
+export const ollamaCapabilitySchema = z
+  .object({
+    id: z.string().min(1).max(255),
+    available: z.boolean(),
+  })
+  .strict();
+
+export type OllamaCapability = z.infer<typeof ollamaCapabilitySchema>;
+
+export const ollamaCapabilitiesSchema = z
+  .object({
+    state: ollamaAvailabilitySchema,
+    model_id: z.string().min(1).max(255),
+    capabilities: z.array(ollamaCapabilitySchema).max(100),
+  })
+  .strict();
+
+export type OllamaCapabilities = z.infer<typeof ollamaCapabilitiesSchema>;
+
+const assetIdSchema = z
+  .string()
+  .regex(/^sha256:[0-9a-f]{64}$/);
+
+const sourceOccurrenceEvidenceSchema = z
+  .object({
+    source_occurrence_id: z
+      .string()
+      .regex(/^occurrence:sha256:[0-9a-f]{64}$/),
+    source_id: z.string().min(1).max(500),
+    original_path: z.string().min(1).max(4000),
+  })
+  .strict();
+
+export const groundingEvidenceSchema = z
+  .object({
+    asset_id: assetIdSchema,
+    content_hash: assetIdSchema,
+    title: z.string().max(1000).optional(),
+    matched_metadata: z.array(z.string().max(1000)).max(100),
+    analysis_id: z.string().max(500).optional(),
+    analysis_result_id: z.string().max(500).optional(),
+    evidence_source: z.enum(["search", "lookup"]),
+    source_occurrences: z.array(sourceOccurrenceEvidenceSchema).max(100),
+  })
+  .strict()
+  .superRefine((record, context) => {
+    if (record.asset_id !== record.content_hash) {
+      context.addIssue({
+        code: "custom",
+        path: ["content_hash"],
+        message: "content_hash must equal canonical asset_id",
+      });
+    }
+  });
+
+export type GroundingEvidence = z.infer<typeof groundingEvidenceSchema>;
+
+export const groundedAnswerSchema = z
+  .object({
+    state: z.union([
+      z.literal("answered"),
+      z.literal("insufficient_evidence"),
+      ollamaAvailabilitySchema,
+    ]),
+    answer: z.string(),
+    supporting_assets: z.array(groundingEvidenceSchema),
+    limitations: z.array(z.string()),
+  })
+  .strict();
+
+export type GroundedAnswer = z.infer<typeof groundedAnswerSchema>;
diff --git a/apps/gallery/lib/search/types.ts b/apps/gallery/lib/search/types.ts
new file mode 100644
index 0000000..2b69a1a
--- /dev/null
+++ b/apps/gallery/lib/search/types.ts
@@ -0,0 +1,106 @@
+import { z } from "zod";
+
+export const searchAvailabilitySchema = z.enum([
+  "ready",
+  "unavailable",
+  "stale",
+  "incompatible",
+  "failed",
+]);
+
+export const searchModeSchema = z.enum([
+  "metadata",
+  "semantic",
+  "visual_similarity",
+  "hybrid",
+]);
+
+const relationshipTypeSchema = z.enum([
+  "exact_duplicate",
+  "same_asset_occurrence",
+  "near_duplicate_candidate",
+  "visually_similar",
+  "semantically_related",
+  "metadata_match",
+]);
+
+const assetIdSchema = z
+  .string()
+  .regex(/^sha256:[0-9a-f]{64}$/, "Expected canonical lowercase SHA-256 asset_id");
+
+const searchResultSchema = z
+  .object({
+    asset_id: assetIdSchema,
+    content_hash: assetIdSchema,
+    retrieval_mode: searchModeSchema,
+    relationship_type: relationshipTypeSchema,
+    provenance: z
+      .object({
+        source_occurrences: z.array(z.unknown()),
+      })
+      .strict(),
+    components: z.array(
+      z
+        .object({
+          kind: z.string().min(1),
+          score: z.number().finite().optional(),
+        })
+        .strict(),
+    ),
+    score: z.number().finite().optional(),
+  })
+  .strict();
+
+const searchPageSchema = z
+  .object({
+    state: z
+      .object({
+        state: searchAvailabilitySchema,
+        detail: z.string().optional(),
+      })
+      .strict(),
+    results: z.array(searchResultSchema),
+    next_cursor: z.string().max(4096).nullable(),
+  })
+  .strict();
+
+export type SearchAvailability = z.infer<typeof searchAvailabilitySchema>;
+export type SearchMode = z.infer<typeof searchModeSchema>;
+export type SearchState = z.infer<typeof searchPageSchema.shape.state>;
+export type SearchResult = z.infer<typeof searchResultSchema>;
+export type SearchPage = z.infer<typeof searchPageSchema>;
+
+export function parseSearchPage(
+  input: unknown,
+  requestedMode: SearchMode,
+): SearchPage {
+  const page = searchPageSchema.parse(input);
+  for (const result of page.results) {
+    if (result.content_hash !== result.asset_id) {
+      throw new TypeError("Search result content_hash must equal canonical asset_id");
+    }
+    if (result.retrieval_mode !== requestedMode) {
+      throw new TypeError(
+        `Search result does not match requested retrieval mode ${requestedMode}`,
+      );
+    }
+    if (
+      requestedMode === "visual_similarity" &&
+      result.relationship_type === "exact_duplicate"
+    ) {
+      throw new TypeError(
+        "Visual similarity cannot claim an exact duplicate relationship",
+      );
+    }
+    if (
+      requestedMode === "visual_similarity" &&
+      result.relationship_type !== "visually_similar" &&
+      result.relationship_type !== "near_duplicate_candidate"
+    ) {
+      throw new TypeError(
+        "Visual similarity result has an invalid relationship type",
+      );
+    }
+  }
+  return page;
+}
diff --git a/apps/gallery/lib/session/gallery-session-store.ts b/apps/gallery/lib/session/gallery-session-store.ts
new file mode 100644
index 0000000..2fe9cce
--- /dev/null
+++ b/apps/gallery/lib/session/gallery-session-store.ts
@@ -0,0 +1,56 @@
+export type GallerySessionStorage = {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+  removeItem(key: string): Promise<void>;
+};
+
+export type SessionDigest = (value: string) => Promise<string>;
+
+export function normalizeGalleryApiOrigin(value: string): string {
+  const url = new URL(value);
+  const isLocalHttp =
+    url.protocol === "http:" &&
+    ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+  if (
+    (url.protocol !== "https:" && !isLocalHttp) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  ) {
+    throw new TypeError("Invalid Gallery API origin");
+  }
+  return url.origin;
+}
+
+export function createGallerySessionStore(
+  storage: GallerySessionStorage,
+  approvedApiOrigin: string,
+  digest: SessionDigest,
+) {
+  const configuredOrigin = approvedApiOrigin
+    ? normalizeGalleryApiOrigin(approvedApiOrigin)
+    : null;
+
+  async function key(): Promise<string> {
+    if (!configuredOrigin) throw new TypeError("Gallery API is not configured");
+    return `gallery.session.v3.${await digest(configuredOrigin)}`;
+  }
+
+  return {
+    async get(): Promise<string | null> {
+      if (!configuredOrigin) return null;
+      const token = await storage.getItem(await key());
+      return token && token.trim() ? token : null;
+    },
+    async set(token: string): Promise<void> {
+      if (!configuredOrigin) throw new TypeError("Gallery API is not configured");
+      if (!token.trim()) throw new TypeError("Missing Gallery session token");
+      await storage.setItem(await key(), token);
+    },
+    async clear(): Promise<void> {
+      if (!configuredOrigin) return;
+      await storage.removeItem(await key());
+    },
+  };
+}
diff --git a/apps/gallery/lib/sources/native.ts b/apps/gallery/lib/sources/native.ts
new file mode 100644
index 0000000..5443c5b
--- /dev/null
+++ b/apps/gallery/lib/sources/native.ts
@@ -0,0 +1,156 @@
+import type {
+  DiscoveredSourceItem,
+  DocumentPickerAdapter,
+  MediaAsset,
+  MediaLibraryAdapter,
+  MediaPermissionResult,
+  SourceAccessState,
+  SourceDiscoveryPage,
+} from "./types";
+
+function permissionAccessState(
+  permission: MediaPermissionResult,
+): SourceAccessState {
+  if (permission.status === "denied") return "denied";
+  if (permission.status !== "granted") return "unknown";
+  return permission.accessPrivileges === "limited" ? "limited" : "granted";
+}
+
+function mimeForMedia(asset: MediaAsset): string {
+  return asset.mediaType === "video" ? "video/*" : "image/*";
+}
+
+async function defaultMediaLibrary(): Promise<MediaLibraryAdapter> {
+  const library = await import("expo-media-library");
+  return {
+    requestPermissionsAsync: async (input) => {
+      const result = await library.requestPermissionsAsync(
+        input.writeOnly,
+        input.granularPermissions,
+      );
+      return {
+        status: result.status,
+        accessPrivileges: result.accessPrivileges ?? undefined,
+      };
+    },
+    getAssetsAsync: async (input) =>
+      library.getAssetsAsync({
+        first: input.first,
+        after: input.after,
+        mediaType: input.mediaType,
+        sortBy: input.sortBy,
+      }),
+  };
+}
+
+async function defaultDocumentPicker(): Promise<DocumentPickerAdapter> {
+  const picker = await import("expo-document-picker");
+  return {
+    getDocumentAsync: async (input) => {
+      const result = await picker.getDocumentAsync(input);
+      return result.canceled
+        ? { canceled: true }
+        : {
+            canceled: false,
+            assets: result.assets.map((asset) => ({
+              uri: asset.uri,
+              name: asset.name,
+              mimeType: asset.mimeType ?? undefined,
+              size: asset.size,
+              lastModified: asset.lastModified,
+            })),
+          };
+    },
+  };
+}
+
+export async function discoverLocalMediaSources(
+  adapter?: MediaLibraryAdapter,
+  after?: string,
+): Promise<SourceDiscoveryPage> {
+  const media = adapter ?? (await defaultMediaLibrary());
+  const permission = await media.requestPermissionsAsync({
+    writeOnly: false,
+    granularPermissions: ["photo", "video"],
+  });
+  const accessState = permissionAccessState(permission);
+  if (accessState !== "granted" && accessState !== "limited") {
+    return { access_state: accessState, items: [], has_next_page: false };
+  }
+
+  const result = await media.getAssetsAsync({
+    first: 100,
+    ...(after ? { after } : {}),
+    mediaType: ["photo", "video"],
+    sortBy: ["modificationTime"],
+  });
+  return {
+    access_state: accessState,
+    items: result.assets.map((asset) => ({
+      provider: "local_media",
+      discovery_handle: asset.id,
+      source_id: `device-media:${asset.id}`,
+      uri: asset.uri,
+      filename: asset.filename,
+      mime_type: mimeForMedia(asset),
+      modified_at: asset.modificationTime
+        ? new Date(asset.modificationTime).toISOString()
+        : undefined,
+      access_state: accessState,
+    })),
+    end_cursor: result.endCursor,
+    has_next_page: Boolean(
+      result.hasNextPage && result.endCursor && result.endCursor !== after,
+    ),
+    total_count: result.totalCount,
+  };
+}
+
+export async function revalidateDiscoveredSourceAccess(
+  sources: DiscoveredSourceItem[],
+  adapter?: MediaLibraryAdapter,
+): Promise<DiscoveredSourceItem[]> {
+  const media = adapter ?? (await defaultMediaLibrary());
+  const permission = await media.requestPermissionsAsync({
+    writeOnly: false,
+    granularPermissions: ["photo", "video"],
+  });
+  const current = permissionAccessState(permission);
+  const revalidated: SourceAccessState =
+    current === "denied" ? "revoked" : current;
+  return sources.map((source) => ({
+    ...source,
+    access_state:
+      source.provider === "local_media" ? revalidated : source.access_state,
+  }));
+}
+
+export async function pickDocumentSources(
+  adapter?: DocumentPickerAdapter,
+): Promise<SourceDiscoveryPage> {
+  const documents = adapter ?? (await defaultDocumentPicker());
+  const result = await documents.getDocumentAsync({
+    multiple: true,
+    copyToCacheDirectory: false,
+  });
+  if (result.canceled) {
+    return { access_state: "unknown", items: [], has_next_page: false };
+  }
+  return {
+    access_state: "granted",
+    items: result.assets.map((asset) => ({
+      provider: "local_file",
+      discovery_handle: asset.uri,
+      source_id: `document:${asset.uri}`,
+      uri: asset.uri,
+      filename: asset.name,
+      mime_type: asset.mimeType ?? "application/octet-stream",
+      size_bytes: asset.size,
+      modified_at: asset.lastModified
+        ? new Date(asset.lastModified).toISOString()
+        : undefined,
+      access_state: "granted",
+    })),
+    has_next_page: false,
+  };
+}
