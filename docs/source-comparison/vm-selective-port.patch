@@ -0,0 +1,59 @@
+import type { AssetId } from "./contracts";
+import type {
+  GalleryAnnotations,
+  GalleryCatalogueSnapshotV1,
+} from "./types";
+
+export function updateGalleryAnnotations(
+  snapshot: GalleryCatalogueSnapshotV1,
+  assetId: AssetId,
+  patch: Partial<GalleryAnnotations>,
+): GalleryCatalogueSnapshotV1 {
+  if (!snapshot.canonical_assets.some((asset) => asset.asset_id === assetId)) {
+    throw new TypeError(`Cannot annotate unknown asset: ${assetId}`);
+  }
+  if (
+    patch.preferred_source_occurrence_id &&
+    !snapshot.source_occurrences.some(
+      (source) =>
+        source.asset_id === assetId &&
+        source.source_occurrence_id === patch.preferred_source_occurrence_id,
+    )
+  ) {
+    throw new TypeError(
+      `Preferred source occurrence does not belong to asset: ${assetId}`,
+    );
+  }
+
+  const current = snapshot.annotations[assetId] ?? {};
+  return {
+    ...snapshot,
+    canonical_assets: snapshot.canonical_assets.map((asset) => ({ ...asset })),
+    source_occurrences: snapshot.source_occurrences.map((source) => ({ ...source })),
+    analysis_views: snapshot.analysis_views.map((analysis) => ({
+      ...analysis,
+      tags: analysis.tags.map((tag) => ({ ...tag })),
+      objects: analysis.objects.map((object) => ({ ...object })),
+    })),
+    annotations: {
+      ...snapshot.annotations,
+      [assetId]: {
+        ...current,
+        ...patch,
+        labels: patch.labels
+          ? [...patch.labels]
+          : current.labels
+            ? [...current.labels]
+            : undefined,
+      },
+    },
+    discovered_sources: snapshot.discovered_sources.map((source) => ({
+      ...source,
+    })),
+    capability_state: {
+      analysis: { ...snapshot.capability_state.analysis },
+      search: { ...snapshot.capability_state.search },
+      ollama: { ...snapshot.capability_state.ollama },
+    },
+  };
+}
diff --git a/apps/gallery/lib/catalogue/browse.ts b/apps/gallery/lib/catalogue/browse.ts
new file mode 100644
index 0000000..d52af46
--- /dev/null
+++ b/apps/gallery/lib/catalogue/browse.ts
@@ -0,0 +1,129 @@
+import type {
+  CatalogueAssetView,
+  GalleryReviewState,
+} from "./types";
+
+export type CatalogueBrowseFilters = {
+  mime_type?: string;
+  source_kind?: string;
+  tags?: string[];
+  review_state?: GalleryReviewState;
+  category?: string;
+};
+
+export type CatalogueBrowseSort = "asset_id" | "title";
+
+function cloneView(view: CatalogueAssetView): CatalogueAssetView {
+  return {
+    asset_id: view.asset_id,
+    canonical: { ...view.canonical },
+    source_occurrences: view.source_occurrences.map((occurrence) => ({
+      ...occurrence,
+    })),
+    analysis: view.analysis
+      ? {
+          ...view.analysis,
+          tags: view.analysis.tags.map((tag) => ({ ...tag })),
+          objects: view.analysis.objects.map((object) => ({ ...object })),
+        }
+      : null,
+    annotations: {
+      ...view.annotations,
+      labels: view.annotations.labels
+        ? [...view.annotations.labels]
+        : undefined,
+    },
+  };
+}
+
+function titleFor(view: CatalogueAssetView): string {
+  return (
+    view.annotations.title ??
+    view.source_occurrences[0]?.original_path.split(/[\\/]/).at(-1) ??
+    view.asset_id
+  );
+}
+
+function searchableText(view: CatalogueAssetView): string {
+  return [
+    titleFor(view),
+    view.canonical.mime_type,
+    view.annotations.notes,
+    view.annotations.category,
+    view.annotations.subcategory,
+    ...(view.annotations.labels ?? []),
+    view.analysis?.summary,
+    view.analysis?.ocr_text,
+    ...(view.analysis?.tags.map((tag) => tag.label) ?? []),
+    ...(view.analysis?.objects.map((object) => object.label) ?? []),
+    ...view.source_occurrences.flatMap((occurrence) => [
+      occurrence.source_kind,
+      occurrence.source_location,
+      occurrence.original_path,
+      occurrence.source_member,
+    ]),
+  ]
+    .filter((value): value is string => Boolean(value))
+    .join("\n")
+    .toLocaleLowerCase();
+}
+
+function matchesFilters(
+  view: CatalogueAssetView,
+  filters: CatalogueBrowseFilters,
+): boolean {
+  if (filters.mime_type && view.canonical.mime_type !== filters.mime_type) {
+    return false;
+  }
+  if (
+    filters.source_kind &&
+    !view.source_occurrences.some(
+      (occurrence) => occurrence.source_kind === filters.source_kind,
+    )
+  ) {
+    return false;
+  }
+  if (
+    filters.tags?.length &&
+    !filters.tags.every((required) =>
+      view.analysis?.tags.some(
+        (tag) => tag.label.toLocaleLowerCase() === required.toLocaleLowerCase(),
+      ),
+    )
+  ) {
+    return false;
+  }
+  if (
+    filters.review_state &&
+    view.annotations.review_state !== filters.review_state
+  ) {
+    return false;
+  }
+  if (filters.category && view.annotations.category !== filters.category) {
+    return false;
+  }
+  return true;
+}
+
+export function browseCatalogue(
+  views: readonly CatalogueAssetView[],
+  query: string,
+  filters: CatalogueBrowseFilters = {},
+  sort: CatalogueBrowseSort = "asset_id",
+): CatalogueAssetView[] {
+  const normalizedQuery = query.trim().toLocaleLowerCase();
+  return views
+    .filter(
+      (view) =>
+        matchesFilters(view, filters) &&
+        (!normalizedQuery || searchableText(view).includes(normalizedQuery)),
+    )
+    .sort((left, right) => {
+      if (sort === "title") {
+        const titleOrder = titleFor(left).localeCompare(titleFor(right));
+        if (titleOrder !== 0) return titleOrder;
+      }
+      return left.asset_id.localeCompare(right.asset_id);
+    })
+    .map(cloneView);
+}
diff --git a/apps/gallery/lib/catalogue/cache-store.ts b/apps/gallery/lib/catalogue/cache-store.ts
new file mode 100644
index 0000000..a7cbaec
--- /dev/null
+++ b/apps/gallery/lib/catalogue/cache-store.ts
@@ -0,0 +1,218 @@
+import { z } from "zod";
+
+import {
+  assetRecordV1Schema,
+  sourceOccurrenceRecordV1Schema,
+} from "./contracts";
+import type { GalleryCatalogueSnapshotV1 } from "./types";
+
+export type CacheIO = {
+  readPointer(): Promise<string | null>;
+  writePointer(value: string): Promise<void>;
+  readSlot(slot: string): Promise<string>;
+  writeSlot(slot: string, value: string): Promise<void>;
+  readLegacy(): Promise<string | null>;
+  removeLegacy(): Promise<void>;
+};
+
+const analysisViewSchema = z
+  .object({
+    asset_id: z.string().regex(/^sha256:[0-9a-f]{64}$/),
+    status: z.enum([
+      "pending",
+      "processing",
+      "ready",
+      "partial",
+      "unsupported",
+      "failed",
+      "stale",
+    ]),
+    analysis_id: z.string().optional(),
+    result_id: z.string().optional(),
+    summary: z.string().optional(),
+    ocr_text: z.string().optional(),
+    tags: z.array(
+      z.object({
+        label: z.string(),
+        confidence: z.number().min(0).max(1).optional(),
+        source: z.string().optional(),
+      }),
+    ),
+    objects: z.array(
+      z.object({
+        label: z.string(),
+        confidence: z.number().min(0).max(1).optional(),
+      }),
+    ),
+  })
+  .strict();
+
+const annotationsSchema = z
+  .object({
+    review_state: z.enum(["needs_review", "approved", "skipped"]).optional(),
+    review_evidence: z.string().optional(),
+    preferred_source_occurrence_id: z.string().optional(),
+    is_preferred_copy: z.boolean().optional(),
+    notes: z.string().optional(),
+    labels: z.array(z.string()).optional(),
+    title: z.string().optional(),
+    category: z.string().optional(),
+    subcategory: z.string().optional(),
+    display_date: z.string().optional(),
+    display_date_source: z.string().optional(),
+    preview_color: z.string().optional(),
+    thumbnail_data_uri: z.string().optional(),
+    duplicate_group_id: z.string().optional(),
+    is_technical_sidecar: z.boolean().optional(),
+  })
+  .strict();
+
+const discoveredSourceSchema = z
+  .object({
+    provider: z.enum(["local_media", "local_file", "google_drive"]),
+    discovery_handle: z.string(),
+    source_id: z.string(),
+    uri: z.string(),
+    filename: z.string(),
+    mime_type: z.string(),
+    size_bytes: z.number().nonnegative().optional(),
+    modified_at: z.string().optional(),
+    source_name: z.string().optional(),
+    access_state: z.enum([
+      "unknown",
+      "stale",
+      "available",
+      "granted",
+      "limited",
+      "denied",
+      "revoked",
+      "unavailable",
+    ]),
+  })
+  .strict();
+
+const capabilityObservationSchema = z
+  .object({
+    state: z.enum([
+      "unknown",
+      "available",
+      "partial",
+      "stale",
+      "unsupported",
+      "unavailable",
+      "failed",
+    ]),
+    observed_at: z.string().optional(),
+    detail: z.string().optional(),
+  })
+  .strict();
+
+const persistedSnapshotSchema = z
+  .object({
+    schema: z.literal("gallery-catalogue-cache"),
+    schema_version: z.literal(1),
+    saved_at: z.string(),
+    canonical_assets: z.array(assetRecordV1Schema),
+    source_occurrences: z.array(sourceOccurrenceRecordV1Schema),
+    analysis_views: z.array(analysisViewSchema),
+    annotations: z.record(
+      z.string().regex(/^sha256:[0-9a-f]{64}$/),
+      annotationsSchema,
+    ),
+    discovered_sources: z.array(discoveredSourceSchema),
+    capability_state: z
+      .object({
+        analysis: capabilityObservationSchema,
+        search: capabilityObservationSchema,
+        ollama: capabilityObservationSchema,
+      })
+      .strict(),
+  })
+  .strict();
+
+function validSlot(value: string): "0" | "1" {
+  if (value !== "0" && value !== "1") {
+    throw new TypeError("Invalid Gallery cache pointer");
+  }
+  return value;
+}
+
+function decodeSnapshot(value: string): GalleryCatalogueSnapshotV1 {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(value);
+  } catch {
+    throw new TypeError("Invalid Gallery cache JSON");
+  }
+  const parsed = persistedSnapshotSchema.safeParse(raw);
+  if (!parsed.success) {
+    throw new TypeError("Unsupported Gallery cache snapshot");
+  }
+  const snapshot = parsed.data as GalleryCatalogueSnapshotV1;
+  return {
+    ...snapshot,
+    canonical_assets: snapshot.canonical_assets.map((asset) => ({ ...asset })),
+    source_occurrences: snapshot.source_occurrences.map((source) => ({
+      ...source,
+    })),
+    analysis_views: snapshot.analysis_views.map((analysis) => ({
+      ...analysis,
+      tags: analysis.tags.map((tag) => ({ ...tag })),
+      objects: analysis.objects.map((object) => ({ ...object })),
+    })),
+    annotations: Object.fromEntries(
+      Object.entries(snapshot.annotations).map(([assetId, annotation]) => [
+        assetId,
+        {
+          ...annotation,
+          labels: annotation.labels ? [...annotation.labels] : undefined,
+        },
+      ]),
+    ),
+    discovered_sources: snapshot.discovered_sources.map((source) => ({
+      ...source,
+      access_state: "stale",
+    })),
+    capability_state: {
+      analysis: { state: "unknown" },
+      search: { state: "unknown" },
+      ollama: { state: "unknown" },
+    },
+  };
+}
+
+function encodeSnapshot(snapshot: GalleryCatalogueSnapshotV1): string {
+  const parsed = persistedSnapshotSchema.safeParse(snapshot);
+  if (!parsed.success) {
+    throw new TypeError("Unsupported Gallery cache snapshot");
+  }
+  return JSON.stringify(parsed.data);
+}
+
+export function createGalleryCacheStore(io: CacheIO) {
+  let tail: Promise<void> = Promise.resolve();
+  return {
+    async read(): Promise<GalleryCatalogueSnapshotV1 | null> {
+      await tail.catch(() => undefined);
+      const pointer = await io.readPointer();
+      const value =
+        pointer === null
+          ? await io.readLegacy()
+          : await io.readSlot(validSlot(pointer));
+      return value === null ? null : decodeSnapshot(value);
+    },
+    write(snapshot: GalleryCatalogueSnapshotV1): Promise<void> {
+      const encoded = encodeSnapshot(snapshot);
+      const next = tail.catch(() => undefined).then(async () => {
+        const pointer = await io.readPointer();
+        const target =
+          pointer === null ? "0" : validSlot(pointer) === "0" ? "1" : "0";
+        await io.writeSlot(target, encoded);
+        await io.writePointer(target);
+        await io.removeLegacy();
+      });
+      tail = next;
+      return next;
+    },
+  };
+}
diff --git a/apps/gallery/lib/catalogue/contracts.ts b/apps/gallery/lib/catalogue/contracts.ts
new file mode 100644
index 0000000..3316e8e
--- /dev/null
+++ b/apps/gallery/lib/catalogue/contracts.ts
@@ -0,0 +1,68 @@
+import { z } from "zod";
+
+const assetIdSchema = z
+  .string()
+  .regex(/^sha256:[0-9a-f]{64}$/, "Expected canonical lowercase SHA-256 asset_id");
+
+const occurrenceIdSchema = z
+  .string()
+  .regex(
+    /^occurrence:sha256:[0-9a-f]{64}$/,
+    "Expected canonical source occurrence ID",
+  );
+
+export const assetRecordV1Schema = z
+  .object({
+    schema: z.literal("asset-record"),
+    schema_version: z.literal(1),
+    asset_id: assetIdSchema,
+    content_hash: assetIdSchema,
+    storage_locator: z.string(),
+    mime_type: z.string(),
+    size_bytes: z.number().int().nonnegative(),
+    processing_state: z.enum(["ready", "failed"]),
+  })
+  .strict()
+  .superRefine((record, context) => {
+    if (record.asset_id !== record.content_hash) {
+      context.addIssue({
+        code: "custom",
+        path: ["content_hash"],
+        message: "content_hash must equal asset_id for asset-record v1",
+      });
+    }
+  });
+
+export const sourceOccurrenceRecordV1Schema = z
+  .object({
+    schema: z.literal("source-occurrence-record"),
+    schema_version: z.literal(1),
+    source_occurrence_id: occurrenceIdSchema,
+    asset_id: assetIdSchema,
+    source_id: z.string(),
+    source_kind: z.string(),
+    source_location: z.string(),
+    original_path: z.string(),
+    ingest_job_id: z.string(),
+    observed_at: z.string(),
+    source_archive_id: z.string().nullable().optional(),
+    source_archive_location: z.string().nullable().optional(),
+    source_member: z.string().nullable().optional(),
+  })
+  .strict();
+
+export type AssetId = z.infer<typeof assetIdSchema>;
+export type AssetRecordV1 = z.infer<typeof assetRecordV1Schema>;
+export type SourceOccurrenceRecordV1 = z.infer<
+  typeof sourceOccurrenceRecordV1Schema
+>;
+
+export function parseAssetRecordV1(input: unknown): AssetRecordV1 {
+  return assetRecordV1Schema.parse(input);
+}
+
+export function parseSourceOccurrenceRecordV1(
+  input: unknown,
+): SourceOccurrenceRecordV1 {
+  return sourceOccurrenceRecordV1Schema.parse(input);
+}
diff --git a/apps/gallery/lib/catalogue/device-cache.ts b/apps/gallery/lib/catalogue/device-cache.ts
new file mode 100644
index 0000000..a131d06
--- /dev/null
+++ b/apps/gallery/lib/catalogue/device-cache.ts
@@ -0,0 +1,94 @@
+import { createGalleryCacheStore, type CacheIO } from "./cache-store";
+import type { GalleryCatalogueSnapshotV1 } from "./types";
+
+const LEGACY_KEY = "ollamabinsaden.gallery.cache.v1";
+const POINTER_KEY = "gallery.cache.file-pointer.v1";
+const WEB_SLOT_PREFIX = "gallery.cache.slot.";
+
+export type DeviceCacheDependencies = {
+  platform: "web" | "native";
+  document_directory: string | null;
+  storage: {
+    getItem(key: string): Promise<string | null>;
+    setItem(key: string, value: string): Promise<void>;
+    removeItem(key: string): Promise<void>;
+  };
+  files: {
+    readText(path: string): Promise<string>;
+    writeText(path: string, value: string): Promise<void>;
+  };
+};
+
+function nativeCachePath(
+  documentDirectory: string | null,
+  slot: string,
+): string {
+  if (!documentDirectory) {
+    throw new Error("Gallery document storage unavailable");
+  }
+  return `${documentDirectory}gallery-cache-${slot}.json`;
+}
+
+export function createGalleryDeviceCache(
+  dependencies: DeviceCacheDependencies,
+) {
+  const io: CacheIO = {
+    readPointer: () => dependencies.storage.getItem(POINTER_KEY),
+    writePointer: (value) => dependencies.storage.setItem(POINTER_KEY, value),
+    readSlot: async (slot) => {
+      if (dependencies.platform === "web") {
+        const value = await dependencies.storage.getItem(
+          `${WEB_SLOT_PREFIX}${slot}.v1`,
+        );
+        if (value === null) throw new Error("Missing Gallery cache slot");
+        return value;
+      }
+      return dependencies.files.readText(
+        nativeCachePath(dependencies.document_directory, slot),
+      );
+    },
+    writeSlot: (slot, value) =>
+      dependencies.platform === "web"
+        ? dependencies.storage.setItem(`${WEB_SLOT_PREFIX}${slot}.v1`, value)
+        : dependencies.files.writeText(
+            nativeCachePath(dependencies.document_directory, slot),
+            value,
+          ),
+    readLegacy: () => dependencies.storage.getItem(LEGACY_KEY),
+    removeLegacy: () => dependencies.storage.removeItem(LEGACY_KEY),
+  };
+  return createGalleryCacheStore(io);
+}
+
+let defaultCache: Promise<ReturnType<typeof createGalleryDeviceCache>> | null =
+  null;
+
+async function loadDefaultCache() {
+  if (!defaultCache) {
+    defaultCache = Promise.all([
+      import("@react-native-async-storage/async-storage"),
+      import("expo-file-system/legacy"),
+      import("react-native"),
+    ]).then(([storageModule, fileSystem, reactNative]) =>
+      createGalleryDeviceCache({
+        platform: reactNative.Platform.OS === "web" ? "web" : "native",
+        document_directory: fileSystem.documentDirectory,
+        storage: storageModule.default,
+        files: {
+          readText: (path) => fileSystem.readAsStringAsync(path),
+          writeText: (path, value) => fileSystem.writeAsStringAsync(path, value),
+        },
+      }),
+    );
+  }
+  return defaultCache;
+}
+
+export const galleryDeviceCache = {
+  async read(): Promise<GalleryCatalogueSnapshotV1 | null> {
+    return (await loadDefaultCache()).read();
+  },
+  async write(snapshot: GalleryCatalogueSnapshotV1): Promise<void> {
+    return (await loadDefaultCache()).write(snapshot);
+  },
+};
diff --git a/apps/gallery/lib/catalogue/fixture-adapter.ts b/apps/gallery/lib/catalogue/fixture-adapter.ts
new file mode 100644
index 0000000..bbcf48a
--- /dev/null
+++ b/apps/gallery/lib/catalogue/fixture-adapter.ts
@@ -0,0 +1,107 @@
+import { FIXTURE_FILES, type FileRecord } from "../pixeldrive";
+import type { SourceOccurrenceRecordV1 } from "./contracts";
+import {
+  emptyCatalogueSnapshot,
+  type GalleryCatalogueSnapshotV1,
+} from "./types";
+
+const FIXTURE_OBSERVED_AT = "1970-01-01T00:00:00.000Z";
+
+function fixtureOccurrenceId(assetId: string, ordinal: number): string {
+  const assetHex = assetId.slice("sha256:".length);
+  const ordinalHex = ordinal.toString(16).padStart(8, "0");
+  return `occurrence:sha256:${assetHex.slice(0, 56)}${ordinalHex}`;
+}
+
+function fixtureOccurrences(file: FileRecord): SourceOccurrenceRecordV1[] {
+  return file.sources.map((source, index) => ({
+    schema: "source-occurrence-record",
+    schema_version: 1,
+    source_occurrence_id: fixtureOccurrenceId(file.assetId, index + 1),
+    asset_id: file.assetId,
+    source_id: source.sourceId,
+    source_kind: source.sourceKind,
+    source_location: source.sourceLocation,
+    original_path: source.originalPath,
+    ingest_job_id: "fixture-seed-v1",
+    observed_at: FIXTURE_OBSERVED_AT,
+    source_archive_id: source.archiveId ?? null,
+    source_archive_location: source.archiveLocation ?? null,
+    source_member: source.sourceMember ?? null,
+  }));
+}
+
+export function snapshotFromFileRecords(
+  files: FileRecord[],
+  enabled: boolean,
+): GalleryCatalogueSnapshotV1 {
+  if (!enabled) return emptyCatalogueSnapshot();
+
+  return {
+    schema: "gallery-catalogue-cache",
+    schema_version: 1,
+    saved_at: FIXTURE_OBSERVED_AT,
+    canonical_assets: files.map((file) => ({
+      schema: "asset-record",
+      schema_version: 1,
+      asset_id: file.assetId,
+      content_hash: file.assetId,
+      storage_locator: `fixture://${file.assetId}`,
+      mime_type: file.mimeType,
+      size_bytes: file.sizeBytes,
+      processing_state: "ready",
+    })),
+    source_occurrences: files.flatMap(fixtureOccurrences),
+    analysis_views: files.map((file) => ({
+      asset_id: file.assetId,
+      status: file.analysisState === "available" ? "ready" : "unsupported",
+      summary: file.visualDescription || undefined,
+      ocr_text: file.ocrText || undefined,
+      tags: file.tags.map((label) => ({ label, source: "classifier" })),
+      objects: [],
+    })),
+    annotations: Object.fromEntries(
+      files.map((file) => [
+        file.assetId,
+        {
+          review_state:
+            file.reviewState === "NEEDS_REVIEW"
+              ? "needs_review"
+              : file.reviewState === "SKIPPED"
+                ? "skipped"
+                : "approved",
+          review_evidence: file.reviewEvidence,
+          preferred_source_occurrence_id: file.preferredSourceOccurrenceId
+            ? fixtureOccurrences(file).find(
+                (_, index) =>
+                  file.sources[index]?.sourceOccurrenceId ===
+                  file.preferredSourceOccurrenceId,
+              )?.source_occurrence_id
+            : undefined,
+          is_preferred_copy: file.isPreferredCopy,
+          notes: file.userNotes,
+          title: file.fileName,
+          category: file.category,
+          subcategory: file.subcategory,
+          display_date: file.dateTaken,
+          display_date_source: file.dateSource,
+          preview_color: file.previewColor,
+          duplicate_group_id: file.duplicateGroupId,
+          is_technical_sidecar: file.isTechnicalSidecar,
+        },
+      ]),
+    ),
+    discovered_sources: [],
+    capability_state: {
+      analysis: { state: "available", observed_at: FIXTURE_OBSERVED_AT },
+      search: { state: "unavailable", observed_at: FIXTURE_OBSERVED_AT },
+      ollama: { state: "unavailable", observed_at: FIXTURE_OBSERVED_AT },
+    },
+  };
+}
+
+export function snapshotFromFixtures(
+  enabled: boolean,
+): GalleryCatalogueSnapshotV1 {
+  return snapshotFromFileRecords(FIXTURE_FILES, enabled);
+}
diff --git a/apps/gallery/lib/catalogue/import.ts b/apps/gallery/lib/catalogue/import.ts
new file mode 100644
index 0000000..7eee7b1
--- /dev/null
+++ b/apps/gallery/lib/catalogue/import.ts
@@ -0,0 +1,125 @@
+import { z } from "zod";
+
+import {
+  assetRecordV1Schema,
+  sourceOccurrenceRecordV1Schema,
+  type AssetRecordV1,
+  type SourceOccurrenceRecordV1,
+} from "./contracts";
+
+export const MAX_IMPORT_BYTES = 10 * 1024 * 1024;
+
+const canonicalImportMetadataSchema = z
+  .object({
+    asset_id: z.string().regex(/^sha256:[0-9a-f]{64}$/),
+    title: z.string().max(500).optional(),
+    tags: z.array(z.string().max(200)).max(100).optional(),
+    description: z.string().max(20_000).optional(),
+    ocr: z.string().max(50_000).optional(),
+    thumbnail_data_uri: z
+      .string()
+      .max(350_000)
+      .regex(/^data:image\/(png|jpeg|webp);base64,[a-zA-Z0-9+/]+={0,2}$/)
+      .optional(),
+  })
+  .strict();
+
+const canonicalImportEnvelopeSchema = z
+  .object({
+    schema: z.literal("gallery-canonical-import"),
+    schema_version: z.literal(1),
+    assets: z.array(assetRecordV1Schema).min(1).max(20_000),
+    source_occurrences: z
+      .array(sourceOccurrenceRecordV1Schema)
+      .max(100_000)
+      .default([]),
+    metadata: z.array(canonicalImportMetadataSchema).max(20_000).default([]),
+  })
+  .strict();
+
+export type CanonicalImportMetadata = z.infer<
+  typeof canonicalImportMetadataSchema
+>;
+
+export type CanonicalImportBatch = {
+  assets: AssetRecordV1[];
+  source_occurrences: SourceOccurrenceRecordV1[];
+  metadata: CanonicalImportMetadata[];
+};
+
+function invalidExport(error: z.ZodError): TypeError {
+  const detail = error.issues
+    .slice(0, 3)
+    .map((issue) => `${issue.path.join(".")}: ${issue.message}`)
+    .join("; ");
+  return new TypeError(`Invalid canonical export: ${detail}`);
+}
+
+function validateBatch(batch: CanonicalImportBatch): CanonicalImportBatch {
+  if (batch.assets.some((asset) => asset.processing_state !== "ready")) {
+    throw new TypeError(
+      "Invalid canonical export: only ready canonical assets can be imported",
+    );
+  }
+  const assetIds = new Set(batch.assets.map((asset) => asset.asset_id));
+  if (assetIds.size !== batch.assets.length) {
+    throw new TypeError("Duplicate asset IDs in canonical export");
+  }
+  const occurrenceIds = new Set(
+    batch.source_occurrences.map((source) => source.source_occurrence_id),
+  );
+  if (occurrenceIds.size !== batch.source_occurrences.length) {
+    throw new TypeError("Duplicate source occurrence IDs in canonical export");
+  }
+  const metadataIds = new Set(batch.metadata.map((metadata) => metadata.asset_id));
+  if (metadataIds.size !== batch.metadata.length) {
+    throw new TypeError("Duplicate metadata records in canonical export");
+  }
+  if (
+    batch.source_occurrences.some((source) => !assetIds.has(source.asset_id)) ||
+    batch.metadata.some((metadata) => !assetIds.has(metadata.asset_id))
+  ) {
+    throw new TypeError(
+      "Canonical export refers to an asset that is not included",
+    );
+  }
+  return batch;
+}
+
+export function parseCanonicalImport(text: string): CanonicalImportBatch {
+  if (new TextEncoder().encode(text).byteLength > MAX_IMPORT_BYTES) {
+    throw new TypeError(
+      "Import is too large. Use canonical JSON exports of at most 10 MB.",
+    );
+  }
+
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text);
+  } catch {
+    throw new TypeError("Choose a valid canonical JSON export.");
+  }
+
+  if (
+    raw &&
+    typeof raw === "object" &&
+    "schema" in raw &&
+    raw.schema === "asset-record"
+  ) {
+    const parsedAsset = assetRecordV1Schema.safeParse(raw);
+    if (!parsedAsset.success) throw invalidExport(parsedAsset.error);
+    return validateBatch({
+      assets: [parsedAsset.data],
+      source_occurrences: [],
+      metadata: [],
+    });
+  }
+
+  const parsed = canonicalImportEnvelopeSchema.safeParse(raw);
+  if (!parsed.success) throw invalidExport(parsed.error);
+  return validateBatch({
+    assets: parsed.data.assets,
+    source_occurrences: parsed.data.source_occurrences,
+    metadata: parsed.data.metadata,
+  });
+}
diff --git a/apps/gallery/lib/catalogue/merge.ts b/apps/gallery/lib/catalogue/merge.ts
new file mode 100644
index 0000000..33b525c
--- /dev/null
+++ b/apps/gallery/lib/catalogue/merge.ts
@@ -0,0 +1,196 @@
+import {
+  parseAssetRecordV1,
+  parseSourceOccurrenceRecordV1,
+  type AssetRecordV1,
+  type SourceOccurrenceRecordV1,
+} from "./contracts";
+import type {
+  CanonicalImportBatch,
+  CanonicalImportMetadata,
+} from "./import";
+import type {
+  AnalysisView,
+  GalleryAnnotations,
+  GalleryCatalogueSnapshotV1,
+} from "./types";
+
+function sameOccurrence(
+  left: SourceOccurrenceRecordV1,
+  right: SourceOccurrenceRecordV1,
+): boolean {
+  return JSON.stringify(left) === JSON.stringify(right);
+}
+
+function assertBatchRelationships(batch: CanonicalImportBatch): void {
+  const assetIds = new Set<string>();
+  for (const rawAsset of batch.assets) {
+    const asset = parseAssetRecordV1(rawAsset);
+    if (asset.processing_state !== "ready") {
+      throw new TypeError("Only ready canonical assets can be merged");
+    }
+    if (assetIds.has(asset.asset_id)) {
+      throw new TypeError("Duplicate asset IDs in canonical import batch");
+    }
+    assetIds.add(asset.asset_id);
+  }
+  const occurrenceIds = new Set<string>();
+  for (const rawSource of batch.source_occurrences) {
+    const source = parseSourceOccurrenceRecordV1(rawSource);
+    if (occurrenceIds.has(source.source_occurrence_id)) {
+      throw new TypeError("Duplicate source occurrence IDs in import batch");
+    }
+    if (!assetIds.has(source.asset_id)) {
+      throw new TypeError("Import batch contains an orphan source occurrence");
+    }
+    occurrenceIds.add(source.source_occurrence_id);
+  }
+  const metadataIds = new Set<string>();
+  for (const metadata of batch.metadata) {
+    if (metadataIds.has(metadata.asset_id)) {
+      throw new TypeError("Duplicate metadata records in import batch");
+    }
+    if (!assetIds.has(metadata.asset_id)) {
+      throw new TypeError("Import batch contains orphan metadata");
+    }
+    metadataIds.add(metadata.asset_id);
+  }
+}
+
+function mergedAnalysis(
+  previous: AnalysisView | undefined,
+  metadata: CanonicalImportMetadata,
+): AnalysisView {
+  return {
+    asset_id: metadata.asset_id,
+    status: previous?.status ?? "partial",
+    analysis_id: previous?.analysis_id,
+    result_id: previous?.result_id,
+    summary: metadata.description ?? previous?.summary,
+    ocr_text: metadata.ocr ?? previous?.ocr_text,
+    tags: metadata.tags
+      ? metadata.tags.map((label) => ({ label, source: "import" }))
+      : (previous?.tags.map((tag) => ({ ...tag })) ?? []),
+    objects: previous?.objects.map((object) => ({ ...object })) ?? [],
+  };
+}
+
+function mergedAnnotations(
+  previous: GalleryAnnotations | undefined,
+  metadata: CanonicalImportMetadata | undefined,
+): GalleryAnnotations {
+  return {
+    ...(metadata?.title ? { title: metadata.title } : {}),
+    ...previous,
+    thumbnail_data_uri:
+      metadata?.thumbnail_data_uri ?? previous?.thumbnail_data_uri,
+    labels: previous?.labels ? [...previous.labels] : undefined,
+  };
+}
+
+export function mergeCanonicalImport(
+  snapshot: GalleryCatalogueSnapshotV1,
+  batch: CanonicalImportBatch,
+  now: string,
+): GalleryCatalogueSnapshotV1 {
+  const existingAssets = new Map(
+    snapshot.canonical_assets.map((asset) => [asset.asset_id, asset] as const),
+  );
+  for (const rawAsset of batch.assets) {
+    const existing = existingAssets.get(rawAsset.asset_id);
+    if (
+      existing &&
+      (existing.content_hash !== rawAsset.content_hash ||
+        existing.mime_type !== rawAsset.mime_type ||
+        existing.size_bytes !== rawAsset.size_bytes)
+    ) {
+      throw new TypeError(
+        "Conflicting canonical asset metadata. The catalogue was not changed.",
+      );
+    }
+  }
+  assertBatchRelationships(batch);
+
+  const assets = new Map<string, AssetRecordV1>();
+  for (const existing of snapshot.canonical_assets) {
+    assets.set(existing.asset_id, { ...existing });
+  }
+  for (const rawAsset of batch.assets) {
+    const asset = parseAssetRecordV1(rawAsset);
+    if (!assets.has(asset.asset_id)) assets.set(asset.asset_id, { ...asset });
+  }
+
+  const occurrenceOwners = new Map<string, string>();
+  const occurrences = new Map<string, SourceOccurrenceRecordV1>();
+  for (const existing of snapshot.source_occurrences) {
+    occurrenceOwners.set(existing.source_occurrence_id, existing.asset_id);
+    occurrences.set(existing.source_occurrence_id, { ...existing });
+  }
+  for (const rawSource of batch.source_occurrences) {
+    const source = parseSourceOccurrenceRecordV1(rawSource);
+    const owner = occurrenceOwners.get(source.source_occurrence_id);
+    if (owner && owner !== source.asset_id) {
+      throw new TypeError(
+        "Source occurrence is already owned by another asset. The catalogue was not changed.",
+      );
+    }
+    const previous = occurrences.get(source.source_occurrence_id);
+    if (previous && !sameOccurrence(previous, source)) {
+      throw new TypeError(
+        "Conflicting source occurrence provenance. The catalogue was not changed.",
+      );
+    }
+    occurrenceOwners.set(source.source_occurrence_id, source.asset_id);
+    occurrences.set(source.source_occurrence_id, { ...source });
+  }
+
+  const annotations: GalleryCatalogueSnapshotV1["annotations"] = Object.fromEntries(
+    Object.entries(snapshot.annotations).map(([assetId, value]) => [
+      assetId,
+      mergedAnnotations(value, undefined),
+    ]),
+  );
+  const analyses = new Map(
+    snapshot.analysis_views.map((analysis) => [
+      analysis.asset_id,
+      {
+        ...analysis,
+        tags: analysis.tags.map((tag) => ({ ...tag })),
+        objects: analysis.objects.map((object) => ({ ...object })),
+      },
+    ]),
+  );
+  for (const metadata of batch.metadata) {
+    annotations[metadata.asset_id] = mergedAnnotations(
+      annotations[metadata.asset_id],
+      metadata,
+    );
+    analyses.set(
+      metadata.asset_id,
+      mergedAnalysis(analyses.get(metadata.asset_id), metadata),
+    );
+  }
+
+  return {
+    schema: "gallery-catalogue-cache",
+    schema_version: 1,
+    saved_at: now,
+    canonical_assets: [...assets.values()].sort((left, right) =>
+      left.asset_id.localeCompare(right.asset_id),
+    ),
+    source_occurrences: [...occurrences.values()].sort((left, right) =>
+      left.source_occurrence_id.localeCompare(right.source_occurrence_id),
+    ),
+    analysis_views: [...analyses.values()].sort((left, right) =>
+      left.asset_id.localeCompare(right.asset_id),
+    ),
+    annotations,
+    discovered_sources: snapshot.discovered_sources.map((source) => ({
+      ...source,
+    })),
+    capability_state: {
+      analysis: { ...snapshot.capability_state.analysis },
+      search: { ...snapshot.capability_state.search },
+      ollama: { ...snapshot.capability_state.ollama },
+    },
+  };
+}
diff --git a/apps/gallery/lib/catalogue/pick-import.ts b/apps/gallery/lib/catalogue/pick-import.ts
new file mode 100644
index 0000000..5b7fd08
--- /dev/null
+++ b/apps/gallery/lib/catalogue/pick-import.ts
@@ -0,0 +1,39 @@
+import {
+  MAX_IMPORT_BYTES,
+  parseCanonicalImport,
+  type CanonicalImportBatch,
+} from "./import";
+
+export type CanonicalImportSelection = {
+  name: string;
+  mime_type?: string;
+  size_bytes: number;
+  readText(): Promise<string>;
+};
+
+export type CanonicalImportPicker = {
+  pick(): Promise<CanonicalImportSelection | null>;
+};
+
+export async function pickCanonicalImport(
+  adapter?: CanonicalImportPicker,
+): Promise<CanonicalImportBatch | null> {
+  if (!adapter) {
+    throw new TypeError("Canonical import picker is unavailable");
+  }
+  const selected = await adapter.pick();
+  if (!selected) return null;
+
+  const isJson =
+    selected.name.toLowerCase().endsWith(".json") ||
+    selected.mime_type?.toLowerCase().includes("json");
+  if (!isJson) {
+    throw new TypeError("Choose a canonical JSON export");
+  }
+  if (selected.size_bytes > MAX_IMPORT_BYTES) {
+    throw new TypeError("Choose a canonical JSON export of at most 10 MB");
+  }
+
+  const text = await selected.readText();
+  return parseCanonicalImport(text);
+}
diff --git a/apps/gallery/lib/catalogue/types.ts b/apps/gallery/lib/catalogue/types.ts
new file mode 100644
index 0000000..119227a
--- /dev/null
+++ b/apps/gallery/lib/catalogue/types.ts
@@ -0,0 +1,140 @@
+import type {
+  AssetId,
+  AssetRecordV1,
+  SourceOccurrenceRecordV1,
+} from "./contracts";
+
+export type AnalysisStatus =
+  | "pending"
+  | "processing"
+  | "ready"
+  | "partial"
+  | "unsupported"
+  | "failed"
+  | "stale";
+
+export type AnalysisTag = {
+  label: string;
+  confidence?: number;
+  source?: string;
+};
+
+export type AnalysisObject = {
+  label: string;
+  confidence?: number;
+};
+
+export type AnalysisView = {
+  asset_id: AssetId;
+  status: AnalysisStatus;
+  analysis_id?: string;
+  result_id?: string;
+  summary?: string;
+  ocr_text?: string;
+  tags: AnalysisTag[];
+  objects: AnalysisObject[];
+};
+
+export type GalleryReviewState = "needs_review" | "approved" | "skipped";
+
+export type GalleryAnnotations = {
+  review_state?: GalleryReviewState;
+  review_evidence?: string;
+  preferred_source_occurrence_id?: string;
+  is_preferred_copy?: boolean;
+  notes?: string;
+  labels?: string[];
+  title?: string;
+  category?: string;
+  subcategory?: string;
+  display_date?: string;
+  display_date_source?: string;
+  preview_color?: string;
+  thumbnail_data_uri?: string;
+  duplicate_group_id?: string;
+  is_technical_sidecar?: boolean;
+};
+
+export type SourceAccessState =
+  | "unknown"
+  | "stale"
+  | "available"
+  | "granted"
+  | "limited"
+  | "denied"
+  | "revoked"
+  | "unavailable";
+
+export type DiscoveredSourceItem = {
+  provider: "local_media" | "local_file" | "google_drive";
+  discovery_handle: string;
+  source_id: string;
+  uri: string;
+  filename: string;
+  mime_type: string;
+  size_bytes?: number;
+  modified_at?: string;
+  source_name?: string;
+  access_state: SourceAccessState;
+};
+
+export type RuntimeCapabilityState =
+  | "unknown"
+  | "available"
+  | "partial"
+  | "stale"
+  | "unsupported"
+  | "unavailable"
+  | "failed";
+
+export type CapabilityObservation = {
+  state: RuntimeCapabilityState;
+  observed_at?: string;
+  detail?: string;
+};
+
+export type CapabilityStateSnapshot = {
+  analysis: CapabilityObservation;
+  search: CapabilityObservation;
+  ollama: CapabilityObservation;
+};
+
+export type GalleryCatalogueSnapshotV1 = {
+  schema: "gallery-catalogue-cache";
+  schema_version: 1;
+  saved_at: string;
+  canonical_assets: AssetRecordV1[];
+  source_occurrences: SourceOccurrenceRecordV1[];
+  analysis_views: AnalysisView[];
+  annotations: Record<AssetId, GalleryAnnotations>;
+  discovered_sources: DiscoveredSourceItem[];
+  capability_state: CapabilityStateSnapshot;
+};
+
+export type CatalogueAssetView = {
+  asset_id: AssetId;
+  canonical: AssetRecordV1;
+  source_occurrences: SourceOccurrenceRecordV1[];
+  analysis: AnalysisView | null;
+  annotations: GalleryAnnotations;
+};
+
+export function emptyCatalogueSnapshot(
+  savedAt = new Date(0).toISOString(),
+): GalleryCatalogueSnapshotV1 {
+  return {
+    schema: "gallery-catalogue-cache",
+    schema_version: 1,
+    saved_at: savedAt,
+    canonical_assets: [],
+    source_occurrences: [],
+    analysis_views: [],
+    annotations: {},
+    discovered_sources: [],
+    capability_state: {
+      analysis: { state: "unknown" },
+      search: { state: "unknown" },
+      ollama: { state: "unknown" },
+    },
+  };
+}
diff --git a/apps/gallery/lib/catalogue/view-model.ts b/apps/gallery/lib/catalogue/view-model.ts
new file mode 100644
index 0000000..e72e602
--- /dev/null
+++ b/apps/gallery/lib/catalogue/view-model.ts
@@ -0,0 +1,71 @@
+import type { AssetId } from "./contracts";
+import type {
+  AnalysisView,
+  CatalogueAssetView,
+  GalleryAnnotations,
+  GalleryCatalogueSnapshotV1,
+} from "./types";
+
+function cloneAnalysis(analysis: AnalysisView): AnalysisView {
+  return {
+    ...analysis,
+    tags: analysis.tags.map((tag) => ({ ...tag })),
+    objects: analysis.objects.map((object) => ({ ...object })),
+  };
+}
+
+function cloneAnnotations(annotations: GalleryAnnotations): GalleryAnnotations {
+  return {
+    ...annotations,
+    labels: annotations.labels ? [...annotations.labels] : undefined,
+  };
+}
+
+function assertNoOrphans(snapshot: GalleryCatalogueSnapshotV1): void {
+  const assetIds = new Set(snapshot.canonical_assets.map((asset) => asset.asset_id));
+  const orphanOccurrence = snapshot.source_occurrences.find(
+    (source) => !assetIds.has(source.asset_id),
+  );
+  if (orphanOccurrence) {
+    throw new TypeError(
+      `Orphan source occurrence: ${orphanOccurrence.source_occurrence_id}`,
+    );
+  }
+  const orphanAnalysis = snapshot.analysis_views.find(
+    (analysis) => !assetIds.has(analysis.asset_id),
+  );
+  if (orphanAnalysis) {
+    throw new TypeError(`Orphan Analysis view: ${orphanAnalysis.asset_id}`);
+  }
+  const orphanAnnotation = Object.keys(snapshot.annotations).find(
+    (assetId) => !assetIds.has(assetId),
+  );
+  if (orphanAnnotation) {
+    throw new TypeError(`Orphan Gallery annotation: ${orphanAnnotation}`);
+  }
+}
+
+export function buildCatalogueAssetView(
+  assetId: AssetId,
+  snapshot: GalleryCatalogueSnapshotV1,
+): CatalogueAssetView {
+  assertNoOrphans(snapshot);
+  const canonical = snapshot.canonical_assets.find(
+    (asset) => asset.asset_id === assetId,
+  );
+  if (!canonical) {
+    throw new TypeError(`Unknown canonical asset: ${assetId}`);
+  }
+  const analysis = snapshot.analysis_views.find(
+    (candidate) => candidate.asset_id === assetId,
+  );
+  return {
+    asset_id: canonical.asset_id,
+    canonical: { ...canonical },
+    source_occurrences: snapshot.source_occurrences
+      .filter((source) => source.asset_id === assetId)
+      .map((source) => ({ ...source })),
+    analysis: analysis ? cloneAnalysis(analysis) : null,
+    annotations: cloneAnnotations(snapshot.annotations[assetId] ?? {}),
+  };
+}
