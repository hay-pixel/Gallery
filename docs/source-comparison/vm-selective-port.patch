+import type {
+  SearchPage,
+  SearchState,
+} from "../lib/search/types";
+
+export type SearchFilters = {
+  mime_type?: string;
+  source_kind?: string;
+  tags?: string[];
+  asset_ids?: string[];
+};
+
+export type TextSearchRequest = {
+  query: string;
+  filters: SearchFilters;
+  limit: number;
+  cursor: string | null;
+};
+
+export type VisualSearchRequest = {
+  asset_id: string;
+  filters: SearchFilters;
+  limit: number;
+  cursor: string | null;
+};
+
+export type HybridSearchRequest = TextSearchRequest & {
+  visual_seed_asset_id?: string;
+};
+
+export interface SearchGateway {
+  getSearchState(ownerId: string): Promise<SearchState>;
+  searchMetadata(ownerId: string, request: TextSearchRequest): Promise<SearchPage>;
+  searchSemantic(ownerId: string, request: TextSearchRequest): Promise<SearchPage>;
+  findVisuallySimilar(
+    ownerId: string,
+    request: VisualSearchRequest,
+  ): Promise<SearchPage>;
+  searchHybrid(ownerId: string, request: HybridSearchRequest): Promise<SearchPage>;
+}
+
+const unavailablePage = (): SearchPage => ({
+  state: { state: "unavailable" },
+  results: [],
+  next_cursor: null,
+});
+
+export class UnavailableSearchGateway implements SearchGateway {
+  constructor(private readonly _transport?: unknown) {}
+
+  async getSearchState(_ownerId: string): Promise<SearchState> {
+    return { state: "unavailable" };
+  }
+
+  async searchMetadata(
+    _ownerId: string,
+    _request: TextSearchRequest,
+  ): Promise<SearchPage> {
+    return unavailablePage();
+  }
+
+  async searchSemantic(
+    _ownerId: string,
+    _request: TextSearchRequest,
+  ): Promise<SearchPage> {
+    return unavailablePage();
+  }
+
+  async findVisuallySimilar(
+    _ownerId: string,
+    _request: VisualSearchRequest,
+  ): Promise<SearchPage> {
+    return unavailablePage();
+  }
+
+  async searchHybrid(
+    _ownerId: string,
+    _request: HybridSearchRequest,
+  ): Promise<SearchPage> {
+    return unavailablePage();
+  }
+}
