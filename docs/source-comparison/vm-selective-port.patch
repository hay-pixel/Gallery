+import type {
+  DiscoveredSourceItem,
+  SourceAccessState,
+} from "../catalogue/types";
+
+export type { DiscoveredSourceItem, SourceAccessState };
+
+export type MediaPermissionResult = {
+  status: "granted" | "denied" | "undetermined";
+  accessPrivileges?: "all" | "limited" | "none";
+};
+
+export type MediaAsset = {
+  id: string;
+  uri: string;
+  filename: string;
+  mediaType: string;
+  modificationTime?: number;
+};
+
+export type MediaLibraryAdapter = {
+  requestPermissionsAsync(input: {
+    writeOnly: false;
+    granularPermissions: ["photo", "video"];
+  }): Promise<MediaPermissionResult>;
+  getAssetsAsync(input: {
+    first: number;
+    after?: string;
+    mediaType: ["photo", "video"];
+    sortBy: ["modificationTime"];
+  }): Promise<{
+    assets: MediaAsset[];
+    endCursor?: string;
+    hasNextPage?: boolean;
+    totalCount?: number;
+  }>;
+};
+
+export type DocumentPickerAsset = {
+  uri: string;
+  name: string;
+  mimeType?: string;
+  size?: number;
+  lastModified?: number;
+};
+
+export type DocumentPickerAdapter = {
+  getDocumentAsync(input: {
+    multiple: true;
+    copyToCacheDirectory: false;
+  }): Promise<
+    | { canceled: true; assets?: undefined }
+    | { canceled: false; assets: DocumentPickerAsset[] }
+  >;
+};
+
+export type SourceDiscoveryPage = {
+  access_state: SourceAccessState;
+  items: DiscoveredSourceItem[];
+  end_cursor?: string;
+  has_next_page: boolean;
+  total_count?: number;
+};
