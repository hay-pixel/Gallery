+      await expect(
+        router.createCaller({ req: request, res: response, session }).ollama.ask({
+          question: "What happened?",
+          asset_ids: [assetId("a")],
+          [field]: field === "evidence" ? [evidence()] : "attacker-controlled",
+        } as any),
+      ).rejects.toMatchObject({ code: "BAD_REQUEST" });
+    },
+  );
+
+  it.each([
+    ["model_unavailable", "Required model is unavailable"],
+    ["unsupported_capability", "Grounding is unsupported"],
+    ["timeout", "Reasoning timed out"],
+  ] as const)("maps %s without provider details", async (state, safeMessage) => {
+    const resolver: OllamaGroundingResolver = {
+      resolve: async () => [evidence()],
+    };
+    const gateway = readyGateway(async () => {
+      throw new OllamaGatewayError(state, safeMessage);
+    });
+    const router = createAppRouter({ ollamaGateway: gateway, groundingResolver: resolver });
+    const session = createGallerySession().session;
+
+    await expect(
+      router.createCaller({ req: request, res: response, session }).ollama.ask({
+        question: "What happened?",
+        asset_ids: [assetId("a")],
+      }),
+    ).resolves.toMatchObject({
+      state,
+      answer: "",
+      limitations: [safeMessage],
+    });
+  });
+
+  it.each([
+    { answer: "", cited_asset_ids: [assetId("a")], limitations: [] },
+    { answer: "No citation", cited_asset_ids: [], limitations: [] },
+    {
+      answer: `Unknown [${assetId("f")}]`,
+      cited_asset_ids: [assetId("f")],
+      limitations: [],
+    },
+  ])("withholds malformed or ungrounded gateway answer %#", async (draft) => {
+    const resolver: OllamaGroundingResolver = { resolve: async () => [evidence()] };
+    const gateway = readyGateway(async () => draft);
+    const router = createAppRouter({ ollamaGateway: gateway, groundingResolver: resolver });
+    const session = createGallerySession().session;
+
+    await expect(
+      router.createCaller({ req: request, res: response, session }).ollama.ask({
+        question: "What happened?",
+        asset_ids: [assetId("a")],
+      }),
+    ).resolves.toMatchObject({ state: "degraded", answer: "", supporting_assets: [] });
+  });
+
+  it("maps unknown provider failures without leaking the error body", async () => {
+    const resolver: OllamaGroundingResolver = { resolve: async () => [evidence()] };
+    const gateway = readyGateway(async () => {
+      throw new Error("private provider response and token");
+    });
+    const router = createAppRouter({ ollamaGateway: gateway, groundingResolver: resolver });
+    const session = createGallerySession().session;
+    const answer = await router
+      .createCaller({ req: request, res: response, session })
+      .ollama.ask({ question: "What happened?", asset_ids: [assetId("a")] });
+
+    expect(answer.state).toBe("failed");
+    expect(JSON.stringify(answer)).not.toContain("private provider");
