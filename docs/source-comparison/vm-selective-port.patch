+    ).resolves.toMatchObject({
+      state: "insufficient_evidence",
+      answer: "",
+      supporting_assets: [],
+    });
+    expect(gateway.answerWithGrounding).not.toHaveBeenCalled();
+  });
+
+  it("resolves canonical evidence under the session owner before gateway use", async () => {
+    const owner = createGallerySession().session;
+    const other = createGallerySession().session;
+    const owned = new Map([
+      [owner.ownerId, evidence("a")],
+      [other.ownerId, evidence("b")],
+    ]);
+    const resolver: OllamaGroundingResolver = {
+      resolve: vi.fn(async (ownerId, selection) => {
+        const record = owned.get(ownerId);
+        return record && selection.asset_ids.includes(record.asset_id)
+          ? [record]
+          : [];
+      }),
+    };
+    const gateway = readyGateway(async ({ evidence: supplied }) => ({
+      answer: `Grounded [${supplied[0]!.asset_id}]`,
+      cited_asset_ids: [supplied[0]!.asset_id],
+      limitations: ["Server-owned evidence only."],
+    }));
+    const router = createAppRouter({ ollamaGateway: gateway, groundingResolver: resolver });
+
+    const answer = await router
+      .createCaller({ req: request, res: response, session: owner })
+      .ollama.ask({ question: "What happened?", asset_ids: [assetId("a")] });
+    expect(resolver.resolve).toHaveBeenCalledWith(owner.ownerId, {
+      asset_ids: [assetId("a")],
+    });
+    expect(gateway.answerWithGrounding).toHaveBeenCalledWith({
+      question: "What happened?",
+      evidence: [evidence("a")],
+    });
+    expect(answer).toMatchObject({
+      state: "answered",
+      supporting_assets: [evidence("a")],
+    });
+
+    const crossOwner = await router
+      .createCaller({ req: request, res: response, session: other })
+      .ollama.ask({ question: "What happened?", asset_ids: [assetId("a")] });
+    expect(crossOwner.state).toBe("insufficient_evidence");
+    expect(gateway.answerWithGrounding).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["evidence", "ownerId", "baseUrl", "authToken"])(
+    "rejects client-supplied %s fields",
+    async (field) => {
+      const session = createGallerySession().session;
