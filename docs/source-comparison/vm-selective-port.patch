+import { describe, expect, it } from "vitest";
+
+import { browseCatalogue } from "../lib/catalogue/browse";
+import { snapshotFromFixtures } from "../lib/catalogue/fixture-adapter";
+import { buildCatalogueAssetView } from "../lib/catalogue/view-model";
+
+function fixtureViews() {
+  const snapshot = snapshotFromFixtures(true);
+  return snapshot.canonical_assets.map((asset) =>
+    buildCatalogueAssetView(asset.asset_id, snapshot),
+  );
+}
+
+describe("in-memory canonical catalogue browse", () => {
+  it("filters canonical title MIME source tag and annotation fields", () => {
+    const views = fixtureViews();
+
+    expect(
+      browseCatalogue(views, "speaker", {}, "title").map(
+        (view) => view.annotations.title,
+      ),
+    ).toContain("speaker_wires_circled.jpg");
+    expect(
+      browseCatalogue(views, "", { mime_type: "application/pdf" }, "title")
+        .length,
+    ).toBeGreaterThan(0);
+    expect(
+      browseCatalogue(views, "", { source_kind: "fixture" }, "asset_id"),
+    ).toHaveLength(views.length);
+    expect(
+      browseCatalogue(views, "vehicle", { tags: ["car"] }, "title").map(
+        (view) => view.annotations.title,
+      ),
+    ).toEqual(["commodore_engine_walkthrough.mp4"]);
+    expect(
+      browseCatalogue(
+        views,
+        "",
+        { review_state: "needs_review" },
+        "title",
+      ).every((view) => view.annotations.review_state === "needs_review"),
+    ).toBe(true);
+  });
+
+  it("returns deterministic asset order for empty query", () => {
+    const views = fixtureViews().reverse();
+    const first = browseCatalogue(views, "", {}, "asset_id").map(
+      (view) => view.asset_id,
+    );
+    const second = browseCatalogue([...views].reverse(), "", {}, "asset_id").map(
+      (view) => view.asset_id,
+    );
+
+    expect(first).toEqual([...first].sort());
+    expect(second).toEqual(first);
+  });
+
+  it("returns cloned views callers cannot use to mutate catalogue state", () => {
+    const views = fixtureViews();
+    const result = browseCatalogue(views, "speaker", {}, "title");
+
+    result[0]!.annotations.notes = "changed";
+    result[0]!.analysis!.tags[0]!.label = "changed";
+    result[0]!.source_occurrences[0]!.original_path = "changed";
+
+    expect(views.find((view) => view.asset_id === result[0]!.asset_id)?.annotations.notes).not.toBe(
+      "changed",
+    );
+    expect(
+      views.find((view) => view.asset_id === result[0]!.asset_id)?.analysis
+        ?.tags[0]?.label,
+    ).not.toBe("changed");
+    expect(
+      views.find((view) => view.asset_id === result[0]!.asset_id)
+        ?.source_occurrences[0]?.original_path,
+    ).not.toBe("changed");
+  });
+
+  it("never fabricates Search provenance index or score fields", () => {
+    const [result] = browseCatalogue(fixtureViews(), "speaker", {}, "title");
+
+    expect(result).not.toHaveProperty("retrieval_mode");
+    expect(result).not.toHaveProperty("index_id");
+    expect(result).not.toHaveProperty("score");
+  });
+});
diff --git a/apps/gallery/tests/gallery-cache.test.ts b/apps/gallery/tests/gallery-cache.test.ts
new file mode 100644
index 0000000..f8bdb5b
--- /dev/null
+++ b/apps/gallery/tests/gallery-cache.test.ts
@@ -0,0 +1,267 @@
+import { describe, expect, it, vi } from "vitest";
+
+import {
+  createGalleryCacheStore,
+  type CacheIO,
+} from "../lib/catalogue/cache-store";
+import {
+  createGalleryDeviceCache,
+  type DeviceCacheDependencies,
+} from "../lib/catalogue/device-cache";
+import type { GalleryCatalogueSnapshotV1 } from "../lib/catalogue/types";
+
+const assetId = `sha256:${"a".repeat(64)}`;
+const occurrenceId = `occurrence:sha256:${"b".repeat(64)}`;
+
+function snapshot(revision: number, sourceCount = 1): GalleryCatalogueSnapshotV1 {
+  return {
+    schema: "gallery-catalogue-cache",
+    schema_version: 1,
+    saved_at: `2026-10-06T00:00:0${revision}.000Z`,
+    canonical_assets: [
+      {
+        schema: "asset-record",
+        schema_version: 1,
+        asset_id: assetId,
+        content_hash: assetId,
+        storage_locator: "/private/extract/store/a.jpg",
+        mime_type: "image/jpeg",
+        size_bytes: 42,
+        processing_state: "ready",
+      },
+    ],
+    source_occurrences: [
+      {
+        schema: "source-occurrence-record",
+        schema_version: 1,
+        source_occurrence_id: occurrenceId,
+        asset_id: assetId,
+        source_id: "archive-1",
+        source_kind: "zip",
+        source_location: "export.zip",
+        original_path: "photos/a.jpg",
+        ingest_job_id: "job-1",
+        observed_at: "2026-10-06T00:00:00.000Z",
+      },
+    ],
+    analysis_views: [],
+    annotations: {
+      [assetId]: {
+        review_state: "approved",
+        notes: `revision-${revision}`,
+      },
+    },
+    discovered_sources: Array.from({ length: sourceCount }, (_, index) => ({
+      provider: "local_media" as const,
+      discovery_handle: `media-${index}`,
+      source_id: `device-media-${index}`,
+      uri: `content://media/${index}`,
+      filename: `IMG_${index}.jpg`,
+      mime_type: "image/jpeg",
+      access_state: "available" as never,
+    })),
+    capability_state: {
+      analysis: { state: "available", observed_at: "2026-10-06T00:00:00Z" },
+      search: { state: "available", observed_at: "2026-10-06T00:00:00Z" },
+      ollama: { state: "available", observed_at: "2026-10-06T00:00:00Z" },
+    },
+  };
+}
+
+function memoryIO(initialLegacy: string | null = null) {
+  let pointer: string | null = null;
+  let legacy = initialLegacy;
+  const slots = new Map<string, string>();
+  const io: CacheIO = {
+    readPointer: async () => pointer,
+    writePointer: async (value) => {
+      pointer = value;
+    },
+    readSlot: async (slot) => {
+      const value = slots.get(slot);
+      if (value === undefined) throw new Error("Missing slot");
+      return value;
+    },
+    writeSlot: async (slot, value) => {
+      slots.set(slot, value);
+    },
+    readLegacy: async () => legacy,
+    removeLegacy: async () => {
+      legacy = null;
+    },
+  };
+  return {
+    io,
+    slots,
+    getPointer: () => pointer,
+    setPointer: (value: string | null) => {
+      pointer = value;
+    },
+    getLegacy: () => legacy,
+  };
+}
+
+describe("Gallery two-slot cache", () => {
+  it("restores 20,000 sources and durable records after restart while resetting freshness", async () => {
+    const memory = memoryIO();
+    await createGalleryCacheStore(memory.io).write(snapshot(1, 20_000));
+
+    const restored = await createGalleryCacheStore(memory.io).read();
+
+    expect(restored?.canonical_assets[0]?.asset_id).toBe(assetId);
+    expect(restored?.source_occurrences[0]?.source_occurrence_id).toBe(
+      occurrenceId,
+    );
+    expect(restored?.annotations[assetId]?.notes).toBe("revision-1");
+    expect(restored?.discovered_sources).toHaveLength(20_000);
+    expect(
+      new Set(restored?.discovered_sources.map((item) => item.access_state)),
+    ).toEqual(new Set(["stale"]));
+    expect(restored?.capability_state).toEqual({
+      analysis: { state: "unknown" },
+      search: { state: "unknown" },
+      ollama: { state: "unknown" },
+    });
+  });
+
+  it("keeps the previous complete snapshot when a slot write fails", async () => {
+    const memory = memoryIO();
+    const cache = createGalleryCacheStore(memory.io);
+    await cache.write(snapshot(1));
+    memory.io.writeSlot = vi.fn(async () => {
+      throw new Error("Disk full");
+    });
+
+    await expect(cache.write(snapshot(2))).rejects.toThrow("Disk full");
+    expect(
+      (await createGalleryCacheStore(memory.io).read())?.annotations[assetId]
+        ?.notes,
+    ).toBe("revision-1");
+  });
+
+  it("keeps the committed snapshot when pointer update fails", async () => {
+    const memory = memoryIO();
+    const cache = createGalleryCacheStore(memory.io);
+    await cache.write(snapshot(1));
+    memory.io.writePointer = vi.fn(async () => {
+      throw new Error("Pointer failed");
+    });
+
+    await expect(cache.write(snapshot(2))).rejects.toThrow("Pointer failed");
+    expect(
+      (await createGalleryCacheStore(memory.io).read())?.annotations[assetId]
+        ?.notes,
+    ).toBe("revision-1");
+  });
+
+  it("serializes concurrent writes so the latest call wins", async () => {
+    const memory = memoryIO();
+    const cache = createGalleryCacheStore(memory.io);
+
+    await Promise.all([cache.write(snapshot(1)), cache.write(snapshot(2))]);
+
+    expect((await cache.read())?.annotations[assetId]?.notes).toBe("revision-2");
+  });
+
+  it("reads a recognizable legacy normalized snapshot and removes it after write", async () => {
+    const memory = memoryIO(JSON.stringify(snapshot(1)));
+    const cache = createGalleryCacheStore(memory.io);
+
+    expect((await cache.read())?.annotations[assetId]?.notes).toBe("revision-1");
+    await cache.write(snapshot(2));
+    expect(memory.getLegacy()).toBeNull();
+  });
+
+  it("rejects a corrupt pointer without guessing a slot", async () => {
+    const memory = memoryIO();
+    memory.setPointer("../../private/path");
+
+    await expect(createGalleryCacheStore(memory.io).read()).rejects.toThrow(
+      /invalid Gallery cache pointer/i,
+    );
+  });
+
+  it("rejects unsupported or corrupt snapshot schemas", async () => {
+    const memory = memoryIO();
+    memory.setPointer("0");
+    memory.slots.set("0", JSON.stringify({ ...snapshot(1), schema_version: 2 }));
+    await expect(createGalleryCacheStore(memory.io).read()).rejects.toThrow(
+      /unsupported Gallery cache snapshot/i,
+    );
+    memory.slots.set("0", "{bad-json");
+    await expect(createGalleryCacheStore(memory.io).read()).rejects.toThrow(
+      /invalid Gallery cache JSON/i,
+    );
+  });
+});
+
+function deviceDependencies(platform: "native" | "web") {
+  const storage = new Map<string, string>();
+  const files = new Map<string, string>();
+  const reads: string[] = [];
+  const writes: string[] = [];
+  const dependencies: DeviceCacheDependencies = {
+    platform,
+    document_directory: "/app-owned/",
+    storage: {
+      getItem: async (key) => storage.get(key) ?? null,
+      setItem: async (key, value) => {
+        storage.set(key, value);
+      },
+      removeItem: async (key) => {
+        storage.delete(key);
+      },
+    },
+    files: {
+      readText: async (path) => {
+        reads.push(path);
+        const value = files.get(path);
+        if (value === undefined) throw new Error("Missing file");
+        return value;
+      },
+      writeText: async (path, value) => {
+        writes.push(path);
+        files.set(path, value);
+      },
+    },
+  };
+  return { dependencies, storage, files, reads, writes };
+}
+
+describe("Gallery device cache adapter", () => {
+  it("uses fixed app-owned native slot paths, never imported locators", async () => {
+    const device = deviceDependencies("native");
+    const cache = createGalleryDeviceCache(device.dependencies);
+
+    await cache.write(snapshot(1));
+    await cache.read();
+
+    expect(device.writes).toEqual(["/app-owned/gallery-cache-0.json"]);
+    expect(device.reads).toEqual(["/app-owned/gallery-cache-0.json"]);
+    expect(device.writes.join(" ")).not.toContain("/private/extract");
+  });
+
+  it("uses namespaced key-value slots on web", async () => {
+    const device = deviceDependencies("web");
+    await createGalleryDeviceCache(device.dependencies).write(snapshot(1));
+
+    expect([...device.storage.keys()].sort()).toEqual([
+      "gallery.cache.file-pointer.v1",
+      "gallery.cache.slot.0.v1",
+    ]);
+    expect(device.writes).toEqual([]);
+  });
+
+  it("migrates only recognizable legacy catalogue JSON", async () => {
+    const device = deviceDependencies("web");
+    device.storage.set(
+      "ollamabinsaden.gallery.cache.v1",
+      JSON.stringify(snapshot(1)),
+    );
+    const cache = createGalleryDeviceCache(device.dependencies);
+
+    expect((await cache.read())?.annotations[assetId]?.notes).toBe("revision-1");
+    await cache.write(snapshot(2));
+    expect(device.storage.has("ollamabinsaden.gallery.cache.v1")).toBe(false);
+  });
+});
diff --git a/apps/gallery/tests/gallery-canonical-import.test.ts b/apps/gallery/tests/gallery-canonical-import.test.ts
new file mode 100644
index 0000000..f63b355
--- /dev/null
+++ b/apps/gallery/tests/gallery-canonical-import.test.ts
@@ -0,0 +1,402 @@
+import { describe, expect, it } from "vitest";
+
+import { updateGalleryAnnotations } from "../lib/catalogue/annotations";
+import type {
+  AssetRecordV1,
+  SourceOccurrenceRecordV1,
+} from "../lib/catalogue/contracts";
+import {
+  MAX_IMPORT_BYTES,
+  parseCanonicalImport,
+  type CanonicalImportBatch,
+} from "../lib/catalogue/import";
+import { mergeCanonicalImport } from "../lib/catalogue/merge";
+import {
+  pickCanonicalImport,
+  type CanonicalImportPicker,
+} from "../lib/catalogue/pick-import";
+import {
+  emptyCatalogueSnapshot,
+} from "../lib/catalogue/types";
+
+const aid = (hex: string) => `sha256:${hex.repeat(64)}`;
+const oid = (hex: string) => `occurrence:sha256:${hex.repeat(64)}`;
+
+const record = (overrides: Partial<AssetRecordV1> = {}): AssetRecordV1 => ({
+  schema: "asset-record",
+  schema_version: 1,
+  asset_id: aid("a"),
+  content_hash: aid("a"),
+  mime_type: "image/jpeg",
+  size_bytes: 42,
+  storage_locator: "/private/extract/store/a.jpg",
+  processing_state: "ready",
+  ...overrides,
+});
+
+const source = (
+  overrides: Partial<SourceOccurrenceRecordV1> = {},
+): SourceOccurrenceRecordV1 => ({
+  schema: "source-occurrence-record",
+  schema_version: 1,
+  asset_id: aid("a"),
+  source_occurrence_id: oid("b"),
+  source_id: "archive-1",
+  source_kind: "zip",
+  source_location: "export.zip",
+  original_path: "holidays/beach.jpg",
+  ingest_job_id: "job-1",
+  observed_at: "2026-10-06T00:00:00.000Z",
+  ...overrides,
+});
+
+function payload(overrides: Partial<CanonicalImportBatch> = {}) {
+  return {
+    schema: "gallery-canonical-import",
+    schema_version: 1,
+    assets: [record()],
+    source_occurrences: [source()],
+    metadata: [
+      {
+        asset_id: aid("a"),
+        title: "Beach",
+        description: "Blue waves at the beach",
+        tags: ["holiday"],
+      },
+    ],
+    ...overrides,
+  };
+}
+
+describe("canonical import parsing", () => {
+  it("accepts a single canonical asset record without dereferencing its locator", () => {
+    const batch = parseCanonicalImport(JSON.stringify(record()));
+
+    expect(batch.assets).toEqual([record()]);
+    expect(batch.source_occurrences).toEqual([]);
+    expect(batch.metadata).toEqual([]);
+  });
+
+  it("accepts a bounded canonical bundle and retains all occurrences", () => {
+    const second = source({
+      source_occurrence_id: oid("c"),
+      source_id: "device-1",
+      source_kind: "device_media",
+      source_location: "Phone",
+      original_path: "DCIM/beach.jpg",
+    });
+    const batch = parseCanonicalImport(
+      JSON.stringify(payload({ source_occurrences: [source(), second] })),
+    );
+
+    expect(batch.assets).toEqual([record()]);
+    expect(batch.source_occurrences).toEqual([source(), second]);
+  });
+
+  it("rejects invalid JSON and UTF-8 payloads over 10 MB", () => {
+    expect(() => parseCanonicalImport("{not-json")) .toThrow(/valid canonical JSON/i);
+    expect(() => parseCanonicalImport("é".repeat(MAX_IMPORT_BYTES))).toThrow(
+      /at most 10 MB/i,
+    );
+  });
+
+  it.each([
+    { ...record(), schema_version: 2 },
+    { ...record(), processing_state: "failed" },
+    { ...record(), content_hash: aid("c") },
+    { ...record(), size_bytes: -1 },
+  ])("rejects incompatible or invalid asset records", (invalid) => {
+    expect(() => parseCanonicalImport(JSON.stringify(invalid))).toThrow(
+      /invalid canonical export/i,
+    );
+  });
+
+  it("rejects duplicate asset occurrence and metadata identities", () => {
+    expect(() =>
+      parseCanonicalImport(
+        JSON.stringify(payload({ assets: [record(), record()] })),
+      ),
+    ).toThrow(/duplicate asset/i);
+    expect(() =>
+      parseCanonicalImport(
+        JSON.stringify(
+          payload({ source_occurrences: [source(), source()] }),
+        ),
+      ),
+    ).toThrow(/duplicate source occurrence/i);
+    expect(() =>
+      parseCanonicalImport(
+        JSON.stringify(
+          payload({
+            metadata: [
+              { asset_id: aid("a"), title: "One" },
+              { asset_id: aid("a"), title: "Two" },
+            ],
+          }),
+        ),
+      ),
+    ).toThrow(/duplicate metadata/i);
+  });
+
+  it("rejects orphan occurrences and metadata", () => {
+    expect(() =>
+      parseCanonicalImport(
+        JSON.stringify(
+          payload({
+            source_occurrences: [source({ asset_id: aid("d") })],
+          }),
+        ),
+      ),
+    ).toThrow(/not included/i);
+    expect(() =>
+      parseCanonicalImport(
+        JSON.stringify(payload({ metadata: [{ asset_id: aid("d") }] })),
+      ),
+    ).toThrow(/not included/i);
+  });
+
+  it("rejects filesystem and remote preview URLs", () => {
+    for (const preview of [
+      "file:///private/extract/photo.jpg",
+      "https://tracking.example/photo.jpg",
+    ]) {
+      expect(() =>
+        parseCanonicalImport(
+          JSON.stringify(
+            payload({
+              metadata: [{ asset_id: aid("a"), thumbnail_data_uri: preview }],
+            }),
+          ),
+        ),
+      ).toThrow(/invalid canonical export/i);
+    }
+  });
+});
+
+describe("canonical import atomic merge", () => {
+  const parsed = () => parseCanonicalImport(JSON.stringify(payload()));
+
+  it("is idempotent and deterministic", () => {
+    const first = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      parsed(),
+      "2026-10-06T01:00:00.000Z",
+    );
+    const second = mergeCanonicalImport(
+      first,
+      parsed(),
+      "2026-10-06T02:00:00.000Z",
+    );
+
+    expect(second.canonical_assets).toEqual(first.canonical_assets);
+    expect(second.source_occurrences).toEqual(first.source_occurrences);
+    expect(second.annotations).toEqual(first.annotations);
+  });
+
+  it("preserves Gallery annotations notes preferred occurrence and prior preview", () => {
+    const imported = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      parseCanonicalImport(
+        JSON.stringify(
+          payload({
+            metadata: [
+              {
+                asset_id: aid("a"),
+                title: "Beach",
+                thumbnail_data_uri: "data:image/png;base64,YQ==",
+              },
+            ],
+          }),
+        ),
+      ),
+      "2026-10-06T01:00:00.000Z",
+    );
+    const reviewed = updateGalleryAnnotations(imported, aid("a"), {
+      review_state: "approved",
+      notes: "Private Gallery note",
+      preferred_source_occurrence_id: oid("b"),
+    });
+    const reimported = mergeCanonicalImport(
+      reviewed,
+      parsed(),
+      "2026-10-06T02:00:00.000Z",
+    );
+
+    expect(reimported.annotations[aid("a")]).toMatchObject({
+      review_state: "approved",
+      notes: "Private Gallery note",
+      preferred_source_occurrence_id: oid("b"),
+      thumbnail_data_uri: "data:image/png;base64,YQ==",
+    });
+  });
+
+  it("merges new occurrences for an existing asset", () => {
+    const first = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      parsed(),
+      "2026-10-06T01:00:00.000Z",
+    );
+    const secondSource = source({
+      source_occurrence_id: oid("c"),
+      source_id: "device-1",
+      source_kind: "device_media",
+      source_location: "Phone",
+      original_path: "DCIM/beach.jpg",
+    });
+    const second = mergeCanonicalImport(
+      first,
+      parseCanonicalImport(
+        JSON.stringify(payload({ source_occurrences: [secondSource] })),
+      ),
+      "2026-10-06T02:00:00.000Z",
+    );
+
+    expect(second.source_occurrences.map((item) => item.source_occurrence_id)).toEqual([
+      oid("b"),
+      oid("c"),
+    ]);
+  });
+
+  it("rejects an occurrence reused by another asset without mutating the input", () => {
+    const first = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      parsed(),
+      "2026-10-06T01:00:00.000Z",
+    );
+    const before = JSON.stringify(first);
+    const other = record({ asset_id: aid("d"), content_hash: aid("d") });
+    const malicious: CanonicalImportBatch = {
+      assets: [other],
+      source_occurrences: [source({ asset_id: aid("d") })],
+      metadata: [],
+    };
+
+    expect(() =>
+      mergeCanonicalImport(first, malicious, "2026-10-06T02:00:00.000Z"),
+    ).toThrow(/source occurrence.*another asset/i);
+    expect(JSON.stringify(first)).toBe(before);
+  });
+
+  it.each([
+    { size_bytes: 84 },
+    { mime_type: "image/png" },
+    { content_hash: aid("c") },
+  ])("rejects canonical conflicts atomically", (conflict) => {
+    const first = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      parsed(),
+      "2026-10-06T01:00:00.000Z",
+    );
+    const before = JSON.stringify(first);
+    const conflictingBatch: CanonicalImportBatch = {
+      assets: [{ ...record(), ...conflict }],
+      source_occurrences: [],
+      metadata: [],
+    };
+
+    expect(() =>
+      mergeCanonicalImport(
+        first,
+        conflictingBatch,
+        "2026-10-06T02:00:00.000Z",
+      ),
+    ).toThrow(/conflicting canonical asset/i);
+    expect(JSON.stringify(first)).toBe(before);
+  });
+
+  it("sorts assets occurrences and metadata views deterministically", () => {
+    const secondAsset = record({ asset_id: aid("0"), content_hash: aid("0") });
+    const secondSource = source({
+      asset_id: aid("0"),
+      source_occurrence_id: oid("0"),
+    });
+    const batch: CanonicalImportBatch = {
+      assets: [record(), secondAsset],
+      source_occurrences: [source(), secondSource],
+      metadata: [
+        { asset_id: aid("a"), title: "A" },
+        { asset_id: aid("0"), title: "Zero" },
+      ],
+    };
+    const merged = mergeCanonicalImport(
+      emptyCatalogueSnapshot(),
+      batch,
+      "2026-10-06T01:00:00.000Z",
+    );
+
+    expect(merged.canonical_assets.map((item) => item.asset_id)).toEqual([
+      aid("0"),
+      aid("a"),
+    ]);
+    expect(
+      merged.source_occurrences.map((item) => item.source_occurrence_id),
+    ).toEqual([oid("0"), oid("b")]);
+    expect(merged.analysis_views.map((item) => item.asset_id)).toEqual([
+      aid("0"),
+      aid("a"),
+    ]);
+  });
+});
+
+describe("canonical import picker", () => {
+  const picker = (
+    result: Awaited<ReturnType<CanonicalImportPicker["pick"]>>,
+  ): CanonicalImportPicker => ({ pick: async () => result });
+
+  it("returns null when selection is cancelled", async () => {
+    await expect(pickCanonicalImport(picker(null))).resolves.toBeNull();
+  });
+
+  it("rejects non-JSON selections before reading", async () => {
+    let read = false;
+    await expect(
+      pickCanonicalImport(
+        picker({
+          name: "photo.jpg",
+          mime_type: "image/jpeg",
+          size_bytes: 4,
+          readText: async () => {
+            read = true;
+            return "nope";
+          },
+        }),
+      ),
+    ).rejects.toThrow(/JSON export/i);
+    expect(read).toBe(false);
+  });
+
+  it("rejects oversized selections before reading", async () => {
+    let read = false;
+    await expect(
+      pickCanonicalImport(
+        picker({
+          name: "export.json",
+          mime_type: "application/json",
+          size_bytes: MAX_IMPORT_BYTES + 1,
+          readText: async () => {
+            read = true;
+            return "{}";
+          },
+        }),
+      ),
+    ).rejects.toThrow(/at most 10 MB/i);
+    expect(read).toBe(false);
+  });
+
+  it("reads bounded UTF-8 and parses before returning", async () => {
+    await expect(
+      pickCanonicalImport(
+        picker({
+          name: "export.json",
+          mime_type: "application/json",
+          size_bytes: 42,
+          readText: async () => JSON.stringify(record()),
+        }),
+      ),
+    ).resolves.toEqual({
+      assets: [record()],
+      source_occurrences: [],
+      metadata: [],
+    });
+  });
+});
diff --git a/apps/gallery/tests/gallery-catalogue.test.ts b/apps/gallery/tests/gallery-catalogue.test.ts
new file mode 100644
index 0000000..c456772
--- /dev/null
+++ b/apps/gallery/tests/gallery-catalogue.test.ts
@@ -0,0 +1,181 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  parseAssetRecordV1,
+  parseSourceOccurrenceRecordV1,
+  type AssetRecordV1,
+  type SourceOccurrenceRecordV1,
+} from "../lib/catalogue/contracts";
+import { updateGalleryAnnotations } from "../lib/catalogue/annotations";
+import { snapshotFromFixtures } from "../lib/catalogue/fixture-adapter";
+import type { GalleryCatalogueSnapshotV1 } from "../lib/catalogue/types";
+import { buildCatalogueAssetView } from "../lib/catalogue/view-model";
+
+const assetId = (hex: string) => `sha256:${hex.repeat(64)}`;
+const occurrenceId = (hex: string) => `occurrence:sha256:${hex.repeat(64)}`;
+
+function asset(overrides: Partial<AssetRecordV1> = {}): AssetRecordV1 {
+  return {
+    schema: "asset-record",
+    schema_version: 1,
+    asset_id: assetId("a"),
+    content_hash: assetId("a"),
+    storage_locator: "catalogue/aa/asset.bin",
+    mime_type: "image/jpeg",
+    size_bytes: 42,
+    processing_state: "ready",
+    ...overrides,
+  };
+}
+
+function occurrence(
+  overrides: Partial<SourceOccurrenceRecordV1> = {},
+): SourceOccurrenceRecordV1 {
+  return {
+    schema: "source-occurrence-record",
+    schema_version: 1,
+    source_occurrence_id: occurrenceId("b"),
+    asset_id: assetId("a"),
+    source_id: "source:drive:personal",
+    source_kind: "google_drive",
+    source_location: "Personal Drive",
+    original_path: "Photos/example.jpg",
+    ingest_job_id: "ingest:test",
+    observed_at: "2026-10-06T00:00:00.000Z",
+    ...overrides,
+  };
+}
+
+function snapshot(
+  overrides: Partial<GalleryCatalogueSnapshotV1> = {},
+): GalleryCatalogueSnapshotV1 {
+  return {
+    schema: "gallery-catalogue-cache",
+    schema_version: 1,
+    saved_at: "2026-10-06T00:00:00.000Z",
+    canonical_assets: [asset()],
+    source_occurrences: [occurrence()],
+    analysis_views: [],
+    annotations: {},
+    discovered_sources: [],
+    capability_state: {
+      analysis: { state: "unknown" },
+      search: { state: "unknown" },
+      ollama: { state: "unknown" },
+    },
+    ...overrides,
+  };
+}
+
+describe("Gallery canonical catalogue contracts", () => {
+  it("accepts asset-record v1 only when asset_id equals content_hash", () => {
+    expect(parseAssetRecordV1(asset())).toEqual(asset());
+
+    expect(() =>
+      parseAssetRecordV1(asset({ content_hash: assetId("c") })),
+    ).toThrow(/content_hash.*asset_id/i);
+  });
+
+  it("rejects paths provider ids and ui ids as asset identity", () => {
+    for (const invalid of [
+      "/storage/emulated/0/DCIM/example.jpg",
+      "drive-file-123",
+      "gallery-card-7",
+      "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
+    ]) {
+      expect(() => parseAssetRecordV1(asset({ asset_id: invalid }))).toThrow();
+    }
+  });
+
+  it("accepts multiple source occurrences for one canonical asset", () => {
+    const second = occurrence({
+      source_occurrence_id: occurrenceId("c"),
+      source_id: "source:device:phone",
+      source_kind: "device_media",
+      source_location: "Phone photos",
+      original_path: "DCIM/example.jpg",
+    });
+    const input = snapshot({ source_occurrences: [occurrence(), second] });
+
+    expect(parseSourceOccurrenceRecordV1(second)).toEqual(second);
+    expect(buildCatalogueAssetView(assetId("a"), input).source_occurrences).toEqual([
+      occurrence(),
+      second,
+    ]);
+  });
+
+  it("rejects orphan source occurrences when assembling a view", () => {
+    const orphan = occurrence({
+      source_occurrence_id: occurrenceId("d"),
+      asset_id: assetId("d"),
+    });
+
+    expect(() =>
+      buildCatalogueAssetView(
+        assetId("a"),
+        snapshot({ source_occurrences: [occurrence(), orphan] }),
+      ),
+    ).toThrow(/orphan.*source occurrence/i);
+  });
+});
+
+describe("Gallery fixture and annotation adapters", () => {
+  it("sample catalogue is empty unless explicitly enabled", () => {
+    expect(snapshotFromFixtures(false).canonical_assets).toEqual([]);
+    expect(snapshotFromFixtures(true).canonical_assets.length).toBeGreaterThan(0);
+  });
+
+  it("exact duplicate fixtures become one asset with multiple occurrences", () => {
+    const fixtureSnapshot = snapshotFromFixtures(true);
+    const duplicate = fixtureSnapshot.canonical_assets.find((candidate) =>
+      fixtureSnapshot.source_occurrences.filter(
+        (source) => source.asset_id === candidate.asset_id,
+      ).length > 1,
+    );
+
+    expect(duplicate).toBeDefined();
+    expect(
+      buildCatalogueAssetView(duplicate!.asset_id, fixtureSnapshot)
+        .source_occurrences,
+    ).toHaveLength(2);
+  });
+
+  it("Gallery annotations do not change canonical or source records", () => {
+    const before = snapshot();
+    const changed = updateGalleryAnnotations(before, assetId("a"), {
+      review_state: "approved",
+      notes: "Checked on device",
+      preferred_source_occurrence_id: occurrenceId("b"),
+    });
+
+    expect(changed.annotations[assetId("a")]).toEqual({
+      review_state: "approved",
+      notes: "Checked on device",
+      preferred_source_occurrence_id: occurrenceId("b"),
+    });
+    expect(changed.canonical_assets).toEqual(before.canonical_assets);
+    expect(changed.source_occurrences).toEqual(before.source_occurrences);
+    expect(changed.canonical_assets).not.toBe(before.canonical_assets);
+    expect(changed.source_occurrences).not.toBe(before.source_occurrences);
+  });
+
+  it("classifier tags are not exposed as detected objects", () => {
+    const input = snapshot({
+      analysis_views: [
+        {
+          asset_id: assetId("a"),
+          status: "ready",
+          tags: [{ label: "sports car", source: "classifier", confidence: 0.9 }],
+          objects: [],
+        },
+      ],
+    });
+
+    const view = buildCatalogueAssetView(assetId("a"), input);
+
+    expect(view.analysis?.tags).toEqual([
+      { label: "sports car", source: "classifier", confidence: 0.9 },
+    ]);
+    expect(view.analysis?.objects).toEqual([]);
+  });
+});
