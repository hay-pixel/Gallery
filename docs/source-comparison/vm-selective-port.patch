@@ -0,0 +1,195 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  discoverLocalMediaSources,
+  pickDocumentSources,
+  revalidateDiscoveredSourceAccess,
+} from "../lib/sources/native";
+import type {
+  DocumentPickerAdapter,
+  MediaLibraryAdapter,
+} from "../lib/sources/types";
+
+describe("Gallery native source discovery", () => {
+  it("requests read-only media access and returns source-only paged items", async () => {
+    let permissionInput: unknown;
+    let pageInput: unknown;
+    const media: MediaLibraryAdapter = {
+      async requestPermissionsAsync(input) {
+        permissionInput = input;
+        return { status: "granted", accessPrivileges: "all" };
+      },
+      async getAssetsAsync(input) {
+        pageInput = input;
+        return {
+          assets: [
+            {
+              id: "provider-media-101",
+              uri: "content://media/external/images/media/101",
+              filename: "IMG_0101.jpg",
+              mediaType: "photo",
+              modificationTime: 2,
+            },
+          ],
+          endCursor: "page-2",
+          hasNextPage: true,
+          totalCount: 20_000,
+        };
+      },
+    };
+
+    const page = await discoverLocalMediaSources(media, "page-1");
+
+    expect(permissionInput).toEqual({
+      writeOnly: false,
+      granularPermissions: ["photo", "video"],
+    });
+    expect(pageInput).toMatchObject({ first: 100, after: "page-1" });
+    expect(page).toMatchObject({
+      access_state: "granted",
+      end_cursor: "page-2",
+      has_next_page: true,
+      total_count: 20_000,
+    });
+    expect(page.items[0]).toMatchObject({
+      provider: "local_media",
+      discovery_handle: "provider-media-101",
+      source_id: "device-media:provider-media-101",
+      access_state: "granted",
+    });
+    expect(page.items[0]).not.toHaveProperty("asset_id");
+    expect(page.items[0]?.discovery_handle).not.toBe(page.items[0]?.uri);
+  });
+
+  it("stops pagination when the provider repeats a cursor", async () => {
+    const media: MediaLibraryAdapter = {
+      async requestPermissionsAsync() {
+        return { status: "granted" };
+      },
+      async getAssetsAsync() {
+        return { assets: [], endCursor: "same", hasNextPage: true };
+      },
+    };
+
+    expect(
+      (await discoverLocalMediaSources(media, "same")).has_next_page,
+    ).toBe(false);
+  });
+
+  it("reports denied permission without enumerating or fabricating assets", async () => {
+    const media: MediaLibraryAdapter = {
+      async requestPermissionsAsync() {
+        return { status: "denied", accessPrivileges: "none" };
+      },
+      async getAssetsAsync() {
+        throw new Error("must not enumerate");
+      },
+    };
+
+    await expect(discoverLocalMediaSources(media)).resolves.toEqual({
+      access_state: "denied",
+      items: [],
+      has_next_page: false,
+    });
+  });
+
+  it("maps limited access without minting canonical identity", async () => {
+    const media: MediaLibraryAdapter = {
+      async requestPermissionsAsync() {
+        return { status: "granted", accessPrivileges: "limited" };
+      },
+      async getAssetsAsync() {
+        return {
+          assets: [
+            {
+              id: "42",
+              uri: "content://media/external/images/media/42",
+              filename: "IMG_0042.jpg",
+              mediaType: "photo",
+            },
+          ],
+        };
+      },
+    };
+
+    const result = await discoverLocalMediaSources(media);
+
+    expect(result.access_state).toBe("limited");
+    expect(result.items[0]?.access_state).toBe("limited");
+    expect(result.items[0]).not.toHaveProperty("asset_id");
+  });
+
+  it("treats restored source access as stale until revoked permission is revalidated", async () => {
+    const restored = [
+      {
+        provider: "local_media" as const,
+        discovery_handle: "42",
+        source_id: "device-media:42",
+        uri: "content://media/42",
+        filename: "IMG_0042.jpg",
+        mime_type: "image/jpeg",
+        access_state: "stale" as const,
+      },
+    ];
+    const media: MediaLibraryAdapter = {
+      async requestPermissionsAsync() {
+        return { status: "denied", accessPrivileges: "none" };
+      },
+      async getAssetsAsync() {
+        throw new Error("must not enumerate");
+      },
+    };
+
+    const revalidated = await revalidateDiscoveredSourceAccess(restored, media);
+
+    expect(restored[0]?.access_state).toBe("stale");
+    expect(revalidated[0]?.access_state).toBe("revoked");
+  });
+
+  it("maps selected documents without copying them to cache", async () => {
+    let pickerInput: unknown;
+    const picker: DocumentPickerAdapter = {
+      async getDocumentAsync(input) {
+        pickerInput = input;
+        return {
+          canceled: false,
+          assets: [
+            {
+              uri: "content://com.android.providers.downloads/doc/7",
+              name: "notes.pdf",
+              mimeType: "application/pdf",
+              size: 2048,
+            },
+          ],
+        };
+      },
+    };
+
+    const result = await pickDocumentSources(picker);
+
+    expect(pickerInput).toEqual({
+      multiple: true,
+      copyToCacheDirectory: false,
+    });
+    expect(result.items[0]).toMatchObject({
+      provider: "local_file",
+      filename: "notes.pdf",
+      access_state: "granted",
+    });
+    expect(result.items[0]).not.toHaveProperty("asset_id");
+  });
+
+  it("returns an empty non-error page when document selection is cancelled", async () => {
+    const picker: DocumentPickerAdapter = {
+      async getDocumentAsync() {
+        return { canceled: true };
+      },
+    };
+
+    await expect(pickDocumentSources(picker)).resolves.toEqual({
+      access_state: "unknown",
+      items: [],
+      has_next_page: false,
+    });
+  });
+});
diff --git a/apps/gallery/tests/gallery-ollama-boundary.test.ts b/apps/gallery/tests/gallery-ollama-boundary.test.ts
new file mode 100644
index 0000000..0bf5852
--- /dev/null
+++ b/apps/gallery/tests/gallery-ollama-boundary.test.ts
@@ -0,0 +1,290 @@
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join, relative } from "node:path";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import type {
+  GroundingEvidence,
+  OllamaAnswerDraft,
+  OllamaGateway,
+  OllamaGroundingResolver,
+} from "../server/ollama-gateway";
+import {
+  OllamaGatewayError,
+  UnavailableOllamaGateway,
+} from "../server/ollama-gateway";
+import { createAppRouter } from "../server/routers";
+import { createGallerySession } from "../server/session";
+
+const assetId = (hex: string) => `sha256:${hex.repeat(64)}`;
+const occurrenceId = (hex: string) => `occurrence:sha256:${hex.repeat(64)}`;
+const request = { headers: {} } as any;
+const response = {} as any;
+
+function sourceFiles(root: string): string[] {
+  return readdirSync(root).flatMap((name) => {
+    if (["node_modules", "dist", ".expo", "tests", "docs"].includes(name)) {
+      return [];
+    }
+    const path = join(root, name);
+    return statSync(path).isDirectory()
+      ? sourceFiles(path)
+      : /(?:\.env\.example|\.(?:ts|tsx|js|json))$/.test(name)
+        ? [path]
+        : [];
+  });
+}
+
+function evidence(hex = "a"): GroundingEvidence {
+  const id = assetId(hex);
+  return {
+    asset_id: id,
+    content_hash: id,
+    title: "Owned asset",
+    matched_metadata: ["analysis.tags:car"],
+    analysis_id: "analysis:logical:owned",
+    analysis_result_id: "analysis-result:owned",
+    evidence_source: "lookup",
+    source_occurrences: [
+      {
+        source_occurrence_id: occurrenceId(hex),
+        source_id: "source:owned",
+        original_path: "camera/owned.jpg",
+      },
+    ],
+  };
+}
+
+function readyGateway(
+  answer: (input: {
+    question: string;
+    model_id?: string;
+    evidence: GroundingEvidence[];
+  }) => OllamaAnswerDraft | Promise<OllamaAnswerDraft>,
+): OllamaGateway {
+  return {
+    health: async () => ({ state: "ready" }),
+    models: async () => ({ state: "ready", models: [{ id: "local-model" }] }),
+    capabilities: async (_modelId) => ({
+      state: "ready",
+      model_id: "local-model",
+      capabilities: [{ id: "grounded_answer", available: true }],
+    }),
+    answerWithGrounding: vi.fn(async (input) => answer(input)),
+  };
+}
+
+describe("private Ollama source boundary", () => {
+  it("keeps raw runtime endpoints and secrets out of client production code", () => {
+    const root = process.cwd();
+    const findings = sourceFiles(root).flatMap((path) => {
+      if (relative(root, path).startsWith("server/")) return [];
+      const source = readFileSync(path, "utf8");
+      return /11434|\/api\/(?:tags|show|generate)|EXPO_PUBLIC_[A-Z0-9_]*OLLAMA|\b(?:baseUrl|rawEndpoint|authToken)\b/.test(
+        source,
+      )
+        ? [relative(root, path)]
+        : [];
+    });
+
+    expect(findings).toEqual([]);
+  });
+
+  it("returns typed unavailable state without invoking a transport", async () => {
+    const transport = vi.fn();
+    const gateway = new UnavailableOllamaGateway(transport);
+
+    await expect(gateway.health()).resolves.toEqual({ state: "unavailable" });
+    await expect(gateway.models()).resolves.toEqual({
+      state: "unavailable",
+      models: [],
+    });
+    await expect(gateway.capabilities("local-model")).resolves.toEqual({
+      state: "unavailable",
+      model_id: "local-model",
+      capabilities: [],
+    });
+    expect(transport).not.toHaveBeenCalled();
+  });
+});
+
+describe("authenticated server-owned Ollama grounding", () => {
+  beforeEach(() => {
+    process.env.JWT_SECRET = "ollama-boundary-test-secret";
+  });
+
+  it("rejects archive reasoning without a signed Gallery session", async () => {
+    const router = createAppRouter();
+    await expect(
+      router.createCaller({ req: request, res: response, session: null }).ollama.ask({
+        question: "What happened?",
+        asset_ids: [assetId("a")],
+      }),
+    ).rejects.toMatchObject({ code: "UNAUTHORIZED" });
+  });
+
+  it("does not call Ollama when owner-scoped evidence is absent", async () => {
+    const gateway = readyGateway(async () => ({
+      answer: "unused",
+      cited_asset_ids: [],
+      limitations: [],
+    }));
+    const resolver: OllamaGroundingResolver = {
+      resolve: vi.fn(async () => []),
+    };
+    const session = createGallerySession().session;
+    const router = createAppRouter({ ollamaGateway: gateway, groundingResolver: resolver });
+
+    await expect(
+      router.createCaller({ req: request, res: response, session }).ollama.ask({
+        question: "What happened?",
+        asset_ids: [assetId("a")],
