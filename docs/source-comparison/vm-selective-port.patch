@@ -0,0 +1,224 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  UnavailableSearchGateway,
+  type SearchGateway,
+} from "../server/search-gateway";
+import { createAppRouter } from "../server/routers";
+import { createGallerySession } from "../server/session";
+import {
+  parseSearchPage,
+  type SearchPage,
+  type SearchResult,
+} from "../lib/search/types";
+
+const assetId = (hex: string) => `sha256:${hex.repeat(64)}`;
+
+const result = (
+  overrides: Partial<SearchResult> = {},
+): SearchResult => ({
+  asset_id: assetId("a"),
+  content_hash: assetId("a"),
+  retrieval_mode: "metadata",
+  relationship_type: "metadata_match",
+  provenance: { source_occurrences: [] },
+  components: [],
+  ...overrides,
+});
+
+const page = (
+  state: SearchPage["state"]["state"],
+  results: SearchResult[] = [],
+): SearchPage => ({ state: { state }, results, next_cursor: null });
+
+describe("Search result contract", () => {
+  it("keeps ready empty no-match distinct from unavailable", () => {
+    expect(parseSearchPage(page("ready"), "metadata")).toEqual(page("ready"));
+    expect(parseSearchPage(page("unavailable"), "metadata").state.state).toBe(
+      "unavailable",
+    );
+  });
+
+  it.each(["unavailable", "stale", "incompatible", "failed"] as const)(
+    "preserves typed %s state",
+    (state) => {
+      expect(parseSearchPage(page(state), "semantic").state.state).toBe(state);
+    },
+  );
+
+  it("keeps cursors nullable and opaque", () => {
+    const input = {
+      ...page("ready", [result()]),
+      next_cursor: "opaque:v1:not-a-row-id",
+    };
+
+    expect(parseSearchPage(input, "metadata").next_cursor).toBe(
+      "opaque:v1:not-a-row-id",
+    );
+  });
+
+  it("requires canonical result identity and matching content hash", () => {
+    expect(() =>
+      parseSearchPage(
+        page("ready", [result({ asset_id: "drive-file-1" })]),
+        "metadata",
+      ),
+    ).toThrow();
+    expect(() =>
+      parseSearchPage(
+        page("ready", [result({ content_hash: assetId("b") })]),
+        "metadata",
+      ),
+    ).toThrow(/content_hash.*asset_id/i);
+  });
+
+  it("rejects exact-duplicate claims from visual similarity", () => {
+    expect(() =>
+      parseSearchPage(
+        page("ready", [
+          result({
+            retrieval_mode: "visual_similarity",
+            relationship_type: "exact_duplicate",
+          }),
+        ]),
+        "visual_similarity",
+      ),
+    ).toThrow(/visual.*exact duplicate/i);
+    expect(
+      parseSearchPage(
+        page("ready", [
+          result({
+            retrieval_mode: "visual_similarity",
+            relationship_type: "visually_similar",
+          }),
+        ]),
+        "visual_similarity",
+      ).results[0]?.relationship_type,
+    ).toBe("visually_similar");
+    expect(
+      parseSearchPage(
+        page("ready", [
+          result({
+            retrieval_mode: "visual_similarity",
+            relationship_type: "near_duplicate_candidate",
+          }),
+        ]),
+        "visual_similarity",
+      ).results[0]?.relationship_type,
+    ).toBe("near_duplicate_candidate");
+    expect(() =>
+      parseSearchPage(
+        page("ready", [
+          result({
+            retrieval_mode: "visual_similarity",
+            relationship_type: "semantically_related",
+          }),
+        ]),
+        "visual_similarity",
+      ),
+    ).toThrow(/visual.*relationship/i);
+  });
+
+  it.each(["semantic", "visual_similarity", "hybrid"] as const)(
+    "does not relabel lexical results as %s",
+    (mode) => {
+      expect(() =>
+        parseSearchPage(page("ready", [result()]), mode),
+      ).toThrow(/requested.*retrieval mode/i);
+    },
+  );
+
+  it("returns typed unavailable without invoking a transport", async () => {
+    const transport = vi.fn();
+    const gateway = new UnavailableSearchGateway(transport);
+
+    await expect(
+      gateway.searchMetadata("owner-a", {
+        query: "beach",
+        filters: {},
+        limit: 20,
+        cursor: null,
+      }),
+    ).resolves.toEqual(page("unavailable"));
+    expect(transport).not.toHaveBeenCalled();
+  });
+});
+
+describe("authenticated Search tRPC boundary", () => {
+  const req = { headers: {} } as any;
+  const res = {} as any;
+
+  beforeEach(() => {
+    process.env.JWT_SECRET = "search-boundary-test-secret";
+  });
+
+  function ownerGateway(calls: string[]): SearchGateway {
+    const ownerSlots = new Map<string, string>();
+    const respond = async (ownerId: string, mode: SearchResult["retrieval_mode"]) => {
+      calls.push(ownerId);
+      const ownerHex = ownerSlots.get(ownerId) ?? (ownerSlots.size === 0 ? "a" : "b");
+      ownerSlots.set(ownerId, ownerHex);
+      const safeHex = /^[0-9a-f]$/.test(ownerHex) ? ownerHex : "a";
+      const relationship =
+        mode === "visual_similarity"
+          ? ("visually_similar" as const)
+          : mode === "semantic"
+            ? ("semantically_related" as const)
+            : ("metadata_match" as const);
+      return page("ready", [
+        result({
+          asset_id: assetId(safeHex),
+          content_hash: assetId(safeHex),
+          retrieval_mode: mode,
+          relationship_type: relationship,
+        }),
+      ]);
+    };
+    return {
+      getSearchState: async () => ({ state: "ready" as const }),
+      searchMetadata: (ownerId) => respond(ownerId, "metadata"),
+      searchSemantic: (ownerId) => respond(ownerId, "semantic"),
+      findVisuallySimilar: (ownerId) => respond(ownerId, "visual_similarity"),
+      searchHybrid: (ownerId) => respond(ownerId, "hybrid"),
+    };
+  }
+
+  it("rejects private Search without a signed Gallery session", async () => {
+    const router = createAppRouter({ searchGateway: ownerGateway([]) });
+
+    await expect(
+      router.createCaller({ req, res, session: null }).search.metadata({
+        query: "beach",
+        filters: {},
+        limit: 20,
+        cursor: null,
+      }),
+    ).rejects.toMatchObject({ code: "UNAUTHORIZED" });
+  });
+
+  it("derives owner scope from each session and rejects caller owner fields", async () => {
+    const calls: string[] = [];
+    const router = createAppRouter({ searchGateway: ownerGateway(calls) });
+    const first = createGallerySession().session;
+    const second = createGallerySession().session;
+    const input = { query: "beach", filters: {}, limit: 20, cursor: null };
+
+    const firstPage = await router
+      .createCaller({ req, res, session: first })
+      .search.metadata(input);
+    const secondPage = await router
+      .createCaller({ req, res, session: second })
+      .search.metadata(input);
+
+    expect(calls).toEqual([first.ownerId, second.ownerId]);
+    expect(firstPage.results[0]?.asset_id).not.toBe(
+      secondPage.results[0]?.asset_id,
+    );
+    await expect(
+      router.createCaller({ req, res, session: first }).search.metadata({
+        ...input,
+        ownerId: second.ownerId,
+      } as any),
+    ).rejects.toMatchObject({ code: "BAD_REQUEST" });
+  });
+});
