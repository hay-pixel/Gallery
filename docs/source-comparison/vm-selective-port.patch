diff --git a/apps/gallery/server/ollama-gateway.ts b/apps/gallery/server/ollama-gateway.ts
new file mode 100644
index 0000000..d516769
--- /dev/null
+++ b/apps/gallery/server/ollama-gateway.ts
@@ -0,0 +1,235 @@
+import { z } from "zod";
+
+import {
+  groundingEvidenceSchema,
+  ollamaCapabilitiesSchema,
+  ollamaHealthSchema,
+  ollamaModelsSchema,
+  type GroundedAnswer,
+  type GroundingEvidence,
+  type OllamaAvailability,
+  type OllamaCapabilities,
+  type OllamaHealth,
+  type OllamaModels,
+} from "../lib/ollama/types";
+
+export type { GroundingEvidence } from "../lib/ollama/types";
+
+export type OllamaGroundingSelection = {
+  asset_ids: string[];
+};
+
+export interface OllamaGroundingResolver {
+  resolve(
+    ownerId: string,
+    selection: OllamaGroundingSelection,
+  ): Promise<GroundingEvidence[]>;
+}
+
+export type OllamaAnswerDraft = {
+  answer: string;
+  cited_asset_ids: string[];
+  limitations: string[];
+};
+
+export interface OllamaGateway {
+  health(): Promise<OllamaHealth>;
+  models(): Promise<OllamaModels>;
+  capabilities(modelId: string): Promise<OllamaCapabilities>;
+  answerWithGrounding(input: {
+    question: string;
+    model_id?: string;
+    evidence: GroundingEvidence[];
+  }): Promise<OllamaAnswerDraft>;
+}
+
+export class OllamaGatewayError extends Error {
+  constructor(
+    public readonly state: Exclude<
+      OllamaAvailability,
+      "ready" | "degraded"
+    >,
+    safeMessage: string,
+  ) {
+    super(safeMessage);
+    this.name = "OllamaGatewayError";
+  }
+}
+
+const unavailable = (state: OllamaAvailability = "unavailable"): GroundedAnswer => ({
+  state,
+  answer: "",
+  supporting_assets: [],
+  limitations: [
+    `Ollama reasoning is ${state.replaceAll("_", " ")}. Gallery browsing and deterministic Search remain available.`,
+  ],
+});
+
+export class UnavailableOllamaGateway implements OllamaGateway {
+  constructor(private readonly _transport?: unknown) {}
+
+  async health(): Promise<OllamaHealth> {
+    return { state: "unavailable" };
+  }
+
+  async models(): Promise<OllamaModels> {
+    return { state: "unavailable", models: [] };
+  }
+
+  async capabilities(modelId: string): Promise<OllamaCapabilities> {
+    return { state: "unavailable", model_id: modelId, capabilities: [] };
+  }
+
+  async answerWithGrounding(): Promise<OllamaAnswerDraft> {
+    throw new OllamaGatewayError(
+      "unavailable",
+      "Ollama reasoning is unavailable.",
+    );
+  }
+}
+
+export class EmptyOllamaGroundingResolver implements OllamaGroundingResolver {
+  async resolve(): Promise<GroundingEvidence[]> {
+    return [];
+  }
+}
+
+const answerDraftSchema = z
+  .object({
+    answer: z.string(),
+    cited_asset_ids: z
+      .array(z.string().regex(/^sha256:[0-9a-f]{64}$/))
+      .max(20),
+    limitations: z.array(z.string().max(1000)).max(20),
+  })
+  .strict();
+
+export async function answerWithServerGrounding(input: {
+  ownerId: string;
+  question: string;
+  model_id?: string;
+  selection: OllamaGroundingSelection;
+  resolver: OllamaGroundingResolver;
+  gateway: OllamaGateway;
+}): Promise<GroundedAnswer> {
+  let evidence: GroundingEvidence[];
+  try {
+    evidence = z.array(groundingEvidenceSchema).max(20).parse(
+      await input.resolver.resolve(input.ownerId, input.selection),
+    );
+  } catch {
+    return unavailable("failed");
+  }
+
+  if (evidence.length === 0) {
+    return {
+      state: "insufficient_evidence",
+      answer: "",
+      supporting_assets: [],
+      limitations: [
+        "No owner-scoped canonical Gallery evidence was available for this question.",
+      ],
+    };
+  }
+
+  try {
+    const draft = answerDraftSchema.parse(
+      await input.gateway.answerWithGrounding({
+        question: input.question,
+        ...(input.model_id ? { model_id: input.model_id } : {}),
+        evidence,
+      }),
+    );
+    const allowed = new Map(evidence.map((item) => [item.asset_id, item]));
+    const citations = [...new Set(draft.cited_asset_ids)];
+    if (
+      !draft.answer.trim() ||
+      citations.length === 0 ||
+      citations.some((assetId) => !allowed.has(assetId))
+    ) {
+      return {
+        state: "degraded",
+        answer: "",
+        supporting_assets: [],
+        limitations: [
+          "The model answer was withheld because it was empty or not grounded in the server-resolved evidence.",
+        ],
+      };
+    }
+    return {
+      state: "answered",
+      answer: draft.answer,
+      supporting_assets: citations.map((assetId) => allowed.get(assetId)!),
+      limitations: draft.limitations,
+    };
+  } catch (error) {
+    if (error instanceof OllamaGatewayError) {
+      return {
+        state: error.state,
+        answer: "",
+        supporting_assets: evidence,
+        limitations: [error.message],
+      };
+    }
+    return unavailable(error instanceof z.ZodError ? "incompatible" : "failed");
+  }
+}
+
+export function safeOllamaHealth(input: unknown): OllamaHealth {
+  const parsed = ollamaHealthSchema.safeParse(input);
+  return parsed.success ? parsed.data : { state: "incompatible" };
+}
+
+export function safeOllamaModels(input: unknown): OllamaModels {
+  const parsed = ollamaModelsSchema.safeParse(input);
+  return parsed.success
+    ? parsed.data
+    : { state: "incompatible", models: [] };
+}
+
+export function safeOllamaCapabilities(
+  input: unknown,
+  modelId: string,
+): OllamaCapabilities {
+  const parsed = ollamaCapabilitiesSchema.safeParse(input);
+  return parsed.success
+    ? parsed.data
+    : { state: "incompatible", model_id: modelId, capabilities: [] };
+}
+
+export async function readOllamaHealth(
+  gateway: OllamaGateway,
+): Promise<OllamaHealth> {
+  try {
+    return safeOllamaHealth(await gateway.health());
+  } catch (error) {
+    return error instanceof OllamaGatewayError
+      ? { state: error.state, detail: error.message }
+      : { state: "failed" };
+  }
+}
+
+export async function readOllamaModels(
+  gateway: OllamaGateway,
+): Promise<OllamaModels> {
+  try {
+    return safeOllamaModels(await gateway.models());
+  } catch (error) {
+    return error instanceof OllamaGatewayError
+      ? { state: error.state, models: [] }
+      : { state: "failed", models: [] };
+  }
+}
+
+export async function readOllamaCapabilities(
+  gateway: OllamaGateway,
+  modelId: string,
+): Promise<OllamaCapabilities> {
+  try {
+    return safeOllamaCapabilities(await gateway.capabilities(modelId), modelId);
+  } catch (error) {
+    return error instanceof OllamaGatewayError
+      ? { state: error.state, model_id: modelId, capabilities: [] }
+      : { state: "failed", model_id: modelId, capabilities: [] };
+  }
+}
