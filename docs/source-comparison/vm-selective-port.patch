+import { describe, expect, it } from "vitest";
+
+import {
+  assistLauncherTarget,
+  deriveCompanionState,
+  extractLauncherTarget,
+  openCompanion,
+} from "../lib/launcher/companion";
+
+describe("optional companion launchers", () => {
+  it("owns stable Extract and Assist schemes", () => {
+    expect(extractLauncherTarget).toMatchObject({
+      app: "extract",
+      scheme: "ollamabinsaden-extract",
+    });
+    expect(assistLauncherTarget).toMatchObject({
+      app: "assist",
+      scheme: "ollamabinsaden-assist",
+    });
+  });
+
+  it.each([
+    [
+      { installed: false, configured: false, compatible: true },
+      "missing",
+    ],
+    [
+      { installed: true, configured: false, compatible: true },
+      "unconfigured",
+    ],
+    [
+      { installed: true, configured: true, compatible: false },
+      "incompatible",
+    ],
+    [{ installed: true, configured: true, compatible: true }, "ready"],
+  ] as const)("derives %s without Search or Ollama state", (probe, expected) => {
+    expect(deriveCompanionState(probe).state).toBe(expected);
+  });
+
+  it("reports a missing app without trying to open it", async () => {
+    let opened = false;
+    const result = await openCompanion(extractLauncherTarget, {
+      canOpenURL: async () => false,
+      openURL: async () => {
+        opened = true;
+      },
+    });
+
+    expect(result.state).toBe("missing");
+    expect(opened).toBe(false);
+  });
+
+  it("opens a ready companion through its owned deep link", async () => {
+    let opened = "";
+    const result = await openCompanion(assistLauncherTarget, {
+      canOpenURL: async () => true,
+      openURL: async (url) => {
+        opened = url;
+      },
+    });
+
+    expect(result.state).toBe("ready");
+    expect(opened).toBe("ollamabinsaden-assist://conversation");
+  });
+
+  it("reports launch failure without impairing Gallery", async () => {
+    const result = await openCompanion(extractLauncherTarget, {
+      canOpenURL: async () => true,
+      openURL: async () => {
+        throw new Error("OS refused launch");
+      },
+    });
+
+    expect(result.state).toBe("launch_failed");
+    expect(result.detail).toContain("could not be opened");
+  });
+});
