+
+  it("maps capability discovery failures without exposing provider details", async () => {
+    const gateway = readyGateway(async () => ({
+      answer: "unused",
+      cited_asset_ids: [],
+      limitations: [],
+    }));
+    gateway.health = vi.fn(async () => {
+      throw new Error("private provider body and host");
+    });
+    const router = createAppRouter({ ollamaGateway: gateway });
+    const session = createGallerySession().session;
+
+    const health = await router
+      .createCaller({ req: request, res: response, session })
