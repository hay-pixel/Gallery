+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+
+import {
+  createGallerySessionStore,
+  normalizeGalleryApiOrigin,
+} from "../lib/session/gallery-session-store";
+
+const digest = async (value: string) =>
+  createHash("sha256").update(value).digest("hex");
+
+function memoryStorage() {
+  const values = new Map<string, string>();
+  return {
+    values,
+    storage: {
+      getItem: async (key: string) => values.get(key) ?? null,
+      setItem: async (key: string, value: string) => {
+        values.set(key, value);
+      },
+      removeItem: async (key: string) => {
+        values.delete(key);
+      },
+    },
+  };
+}
+
+describe("configured-origin Gallery session store", () => {
+  it("persists a signed session across restart for its approved origin", async () => {
+    const memory = memoryStorage();
+    const first = createGallerySessionStore(
+      memory.storage,
+      "https://gallery.example/api",
+      digest,
+    );
+    await first.set("signed-owner-session");
+
+    const restarted = createGallerySessionStore(
+      memory.storage,
+      "https://gallery.example/other-path",
+      digest,
+    );
+    await expect(restarted.get()).resolves.toBe("signed-owner-session");
+  });
+
+  it("isolates approved backend origins and separate secure stores", async () => {
+    const firstMemory = memoryStorage();
+    const secondMemory = memoryStorage();
+    const first = createGallerySessionStore(
+      firstMemory.storage,
+      "https://first.example",
+      digest,
+    );
+    const otherOrigin = createGallerySessionStore(
+      firstMemory.storage,
+      "https://second.example",
+      digest,
+    );
+    const otherTester = createGallerySessionStore(
+      secondMemory.storage,
+      "https://first.example",
+      digest,
+    );
+    await first.set("tester-a");
+    await otherTester.set("tester-b");
+
+    await expect(otherOrigin.get()).resolves.toBeNull();
+    await expect(first.get()).resolves.toBe("tester-a");
+    await expect(otherTester.get()).resolves.toBe("tester-b");
+  });
+
+  it("uses safe keys without tokens URLs or hostnames", async () => {
+    const memory = memoryStorage();
+    const store = createGallerySessionStore(
+      memory.storage,
+      "https://backend.example/gallery",
+      digest,
+    );
+    await store.set("private-owner-token");
+
+    const key = [...memory.values.keys()][0]!;
+    expect(key).toMatch(/^gallery\.session\.v3\.[0-9a-f]{64}$/);
+    expect(key).not.toContain("backend.example");
+    expect(key).not.toContain("private-owner-token");
+  });
+
+  it("has no session before an approved origin is configured", async () => {
+    const store = createGallerySessionStore(memoryStorage().storage, "", digest);
+
+    await expect(store.get()).resolves.toBeNull();
+    await expect(store.set("token")).rejects.toThrow(/not configured/i);
+  });
+
+  it("rejects unsafe remote HTTP protocols URL credentials queries and fragments", () => {
+    for (const value of [
+      "file:///private",
+      "http://remote.example",
+      "https://user:pass@server.example",
+      "https://server.example?token=x",
+      "https://server.example#fragment",
+    ]) {
+      expect(() => normalizeGalleryApiOrigin(value)).toThrow();
+    }
+    expect(normalizeGalleryApiOrigin("http://127.0.0.1:3000/api")).toBe(
+      "http://127.0.0.1:3000",
+    );
+  });
+});
