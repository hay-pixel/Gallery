-export const setGallerySessionToken = (token: string) => AsyncStorage.setItem(GALLERY_SESSION_KEY, token);
+import {
+  createGallerySessionStore,
+  type GallerySessionStorage,
+} from "./session/gallery-session-store";
+
+async function storageForPlatform(): Promise<GallerySessionStorage> {
+  const [{ Platform }, asyncStorage, secureStore] = await Promise.all([
+    import("react-native"),
+    import("@react-native-async-storage/async-storage"),
+    import("expo-secure-store"),
+  ]);
+  return Platform.OS === "web"
+    ? asyncStorage.default
+    : {
+        getItem: (key) => secureStore.getItemAsync(key),
+        setItem: (key, value) => secureStore.setItemAsync(key, value),
+        removeItem: (key) => secureStore.deleteItemAsync(key),
+      };
+}
+
+async function digest(value: string): Promise<string> {
+  const crypto = await import("expo-crypto");
+  return crypto.digestStringAsync(crypto.CryptoDigestAlgorithm.SHA256, value);
+}
+
+async function configuredStore() {
+  const { getApiBaseUrl } = await import("../constants/oauth");
+  return createGallerySessionStore(
+    await storageForPlatform(),
+    getApiBaseUrl(),
+    digest,
+  );
+}
+
+export const getGallerySessionToken = async () =>
+  (await configuredStore()).get();
+
+export const setGallerySessionToken = async (token: string) =>
+  (await configuredStore()).set(token);
diff --git a/apps/gallery/lib/launcher/companion.ts b/apps/gallery/lib/launcher/companion.ts
new file mode 100644
index 0000000..b41a811
--- /dev/null
+++ b/apps/gallery/lib/launcher/companion.ts
@@ -0,0 +1,80 @@
+export type CompanionProbe = {
+  installed: boolean;
+  configured: boolean;
+  compatible: boolean;
+};
+
+export type CompanionState =
+  | "missing"
+  | "unconfigured"
+  | "incompatible"
+  | "ready"
+  | "launch_failed";
+
+export type CompanionStatus = {
+  state: CompanionState;
+  detail: string;
+};
+
+export type CompanionLauncherTarget = {
+  app: "extract" | "assist";
+  label: string;
+  scheme: string;
+  deepLink: string;
+};
+
+export type LinkingAdapter = {
+  canOpenURL(url: string): Promise<boolean>;
+  openURL(url: string): Promise<unknown>;
+};
+
+export const extractLauncherTarget: CompanionLauncherTarget = {
+  app: "extract",
+  label: "Extract",
+  scheme: "ollamabinsaden-extract",
+  deepLink: "ollamabinsaden-extract://import",
+};
+
+export const assistLauncherTarget: CompanionLauncherTarget = {
+  app: "assist",
+  label: "Assist",
+  scheme: "ollamabinsaden-assist",
+  deepLink: "ollamabinsaden-assist://conversation",
+};
+
+export function deriveCompanionState(probe: CompanionProbe): CompanionStatus {
+  if (!probe.installed) {
+    return { state: "missing", detail: "Companion app is not installed." };
+  }
+  if (!probe.compatible) {
+    return {
+      state: "incompatible",
+      detail: "Installed companion is not compatible.",
+    };
+  }
+  if (!probe.configured) {
+    return {
+      state: "unconfigured",
+      detail: "Companion app is installed but not configured.",
+    };
+  }
+  return { state: "ready", detail: "Companion app is ready." };
+}
+
+export async function openCompanion(
+  target: CompanionLauncherTarget,
+  linking: LinkingAdapter,
+): Promise<CompanionStatus> {
+  if (!(await linking.canOpenURL(target.deepLink))) {
+    return { state: "missing", detail: `${target.label} is not installed.` };
+  }
+  try {
+    await linking.openURL(target.deepLink);
+    return { state: "ready", detail: `${target.label} opened.` };
+  } catch {
+    return {
+      state: "launch_failed",
+      detail: `${target.label} could not be opened.`,
+    };
+  }
+}
