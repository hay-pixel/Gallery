# /etc/gallery/gallery.env
# Private production environment configuration for Gallery on AWS Linux (EC2)
# Set ownership to gallery:gallery and chmod 600

NODE_ENV=production
PORT=3000

# Database Configuration (Local MariaDB/MySQL or AWS RDS)
DATABASE_URL=mysql://gallery_user:secure_password_here@127.0.0.1:3306/gallery_db

# Security & Sessions
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-secure-random-jwt-secret

# Google Drive OAuth Credentials (from Google Cloud Console)
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Allowed web origins for OAuth redirect & CORS
GALLERY_WEB_RETURN_ORIGINS=https://gallery.yourdomain.com,http://localhost:8081

# Public Client Configurations (baked into Expo/Android builds)
EXPO_PUBLIC_API_BASE_URL=https://gallery.yourdomain.com
EXPO_PUBLIC_GALLERY_RETURN_ORIGIN=https://gallery.yourdomain.com
