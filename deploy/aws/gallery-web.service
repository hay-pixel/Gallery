[Unit]
Description=Gallery Web Application & API Server
After=network.target gallery-ai.service
Wants=gallery-ai.service

[Service]
Type=simple
User=gallery
Group=gallery
WorkingDirectory=/opt/gallery/apps/gallery
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="AI_GATEWAY_URL=http://127.0.0.1:8000"
EnvironmentFile=-/etc/gallery/gallery-web.env
ExecStart=/usr/bin/node dist/index.mjs
Restart=always
RestartSec=5s

# Hardening & Security
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gallery/uploads
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
