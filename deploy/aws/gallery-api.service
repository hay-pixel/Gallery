[Unit]
Description=Gallery Backend API Server (Node/Express/tRPC)
After=network.target mariadb.service mysql.service
Wants=network.target

[Service]
Type=simple
User=gallery
Group=gallery
WorkingDirectory=/opt/gallery/apps/gallery
Environment=NODE_ENV=production
EnvironmentFile=/etc/gallery/gallery.env
ExecStart=/usr/bin/node /opt/gallery/apps/gallery/dist/index.mjs
Restart=always
RestartSec=5s
LimitNOFILE=65535
UMask=0077

ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/gallery/state
PrivateTmp=true

[Install]
WantedBy=multi-user.target
